///|
/// Tests for the RankProd 3.28.0 port (RankProducts / RP, RS, exact
/// rank-product bounds, dice-sum p-values, pfp, topGene, computeOrirank).
///
/// All expected values were frozen from Bioconductor RankProd 3.28.0 under
/// R 4.3.3 using /tmp/gen_rankprod_expected.R. The null resampling in R was
/// driven by the same 32-bit Numerical-Recipes LCG implemented in
/// src/rankprod.mbt (injected into the package closure), so seeds 314/2718
/// give bit-comparable draws on both sides.

///|
fn rpt_nan() -> Double {
  0.0 / 0.0
}

///|
fn rpt_approx(left : Double, right : Double, tol~ : Double = 1.0e-9) -> Bool {
  if left.is_nan() {
    right.is_nan()
  } else if right.is_nan() {
    false
  } else {
    (left - right).abs() <= tol
  }
}

///|
fn rpt_vec(
  got : Array[Double],
  want : Array[Double],
  tol~ : Double = 1.0e-9,
) -> Unit raise Error {
  assert_eq(got.length(), want.length())
  for i in 0..<got.length() {
    if !rpt_approx(got[i], want[i], tol=tol) {
      println("rpt_vec mismatch at \{i}: got \{got[i]} want \{want[i]}")
    }
    assert_true(rpt_approx(got[i], want[i], tol=tol))
  }
}

///|
fn rpt_ivec(got : Array[Int], want : Array[Int]) -> Unit raise Error {
  assert_eq(got.length(), want.length())
  for i in 0..<got.length() {
    if got[i] != want[i] {
      println("rpt_ivec mismatch at \{i}: got \{got[i]} want \{want[i]}")
    }
    assert_eq(got[i], want[i])
  }
}

///|
fn rpt_raises(operation : () -> Unit raise @src.RankProdError) -> Bool {
  try {
    operation()
    false
  } catch {
    _ => true
  }
}

// ---------------------------------------------------------------------------
// Frozen input matrices (row-major; values rounded to 4-6 decimals in R, so
// the printed literals reproduce the analysis exactly).
// ---------------------------------------------------------------------------

