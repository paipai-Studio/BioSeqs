test "RankProd F: NA median imputation with one pairing" {
  let rp = @src.rank_products(
    data=rpt_mat_f(),
    cl=rpt_cl_f(),
    random_pairs=1,
  )
  assert_eq(rp.n_valid(), 6)
  rpt_vec(
    rp.statistic_down(),
    [1.0, 2.0, 6.0, 3.46410161514, 3.46410161514, 5.0],
  )
  rpt_vec(rp.statistic_up(), [6.0, 5.0, 1.0, 3.46410161514, 3.46410161514, 2.0])
  rpt_vec(
    rp.p_value_down(),
    [
      2.77777777778e-02, 2.19558479712e-01, 1.00000000000, 0.641581042650,
      0.641581042650, 0.921854270831,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rp.p_value_up(),
    [
      1.00000000000, 0.921854270831, 2.77777777778e-02, 0.641581042650,
      0.641581042650, 2.19558479712e-01,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rp.pfp_down(),
    [
      0.166666666667, 0.658675439135, 1.00000000000, 1.28316208530,
      0.962371563975, 1.10622512500,
    ],
    tol=1.0e-9,
  )
  rpt_vec(
    rp.pfp_up(),
    [
      1.00000000000, 1.10622512500, 0.166666666667, 1.28316208530,
      0.962371563975, 0.658675439135,
    ],
    tol=1.0e-9,
  )
  rpt_vec(
    rp.average_fold_change(),
    [-2.70, -2.45, 2.70, 0.00, 0.00, 0.20],
    tol=1.0e-6,
  )
}

test "RankProd F2: bad row excluded with five pairings and LCG seed 2718" {
  let rp = @src.rank_products(
    data=rpt_mat_f(),
    cl=rpt_cl_f(),
    seed=2718,
  )
  assert_eq(rp.random_pairs(), 5)
  assert_eq(rp.n_valid(), 5)
  let nan = rpt_nan()
  rpt_vec(rp.statistic_down(), [1.0, 2.0, 5.0, nan, 3.0, 4.0])
  rpt_vec(rp.statistic_up(), [5.0, 4.0, 1.0, nan, 3.0, 2.0])
  rpt_vec(
    rp.p_value_down(),
    [
      4.00000000000e-02, 3.16164210785e-01, 1.00000000000, nan,
      6.60701952980e-01, 8.88895049419e-01,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rp.p_value_up(),
    [
      1.00000000000, 8.88895049419e-01, 4.00000000000e-02, nan,
      6.60701952980e-01, 3.16164210785e-01,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rp.pfp_down(),
    [0.20, 0.790410526962, 1.0, nan, 1.10116992163, 1.11111881177],
    tol=1.0e-9,
  )
  rpt_vec(
    rp.pfp_up(),
    [1.0, 1.11111881177, 0.20, nan, 1.10116992163, 0.790410526962],
    tol=1.0e-9,
  )
  rpt_vec(
    rp.average_fold_change(),
    [-2.70, -2.45, 2.70, nan, 0.00, 0.20],
    tol=1.0e-6,
  )
  // Every pairing carries identical ranks with the bad row NaN.
  assert_eq(rp.products_down().length(), 5)
  let flat : Array[Double] = []
  for rr in 0..<5 {
    for g in 0..<6 {
      flat.push(rp.products_down()[rr][g])
    }
  }
  rpt_vec(
    flat,
    [
      1.0, 2.0, 5.0, nan, 3.0, 4.0, 1.0, 2.0, 5.0, nan, 3.0, 4.0, 1.0, 2.0,
      5.0, nan, 3.0, 4.0, 1.0, 2.0, 5.0, nan, 3.0, 4.0, 1.0, 2.0, 5.0, nan,
      3.0, 4.0,
    ],
  )
}

