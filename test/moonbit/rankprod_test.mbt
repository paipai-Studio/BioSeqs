// ---------------------------------------------------------------------------
// Orirank: all k1*k2 pairings with average-tie ranks.
// ---------------------------------------------------------------------------

test "rankprod_ori_rank matches computeOrirank on the tie fixture" {
  // R fixture (4 genes x 4 samples): gr1 = cols 1-2, gr2 = cols 3-4.
  let gr1 : Array[Array[Double]] = [
    [1.0, 1.0],
    [1.0, 1.0],
    [5.0, 5.0],
    [5.0, 5.0],
  ]
  let gr2 : Array[Array[Double]] = [
    [2.0, 3.0],
    [3.0, 2.0],
    [1.0, 1.0],
    [2.0, 2.0],
  ]
  let (down, up) = @src.rankprod_ori_rank(gr1=gr1, gr2=gr2)
  assert_eq(down.length(), 4)
  assert_eq(down[0].length(), 4)
  let df : Array[Double] = []
  let uf : Array[Double] = []
  for rr in 0..<4 {
    for g in 0..<4 {
      df.push(down[g][rr])
      uf.push(up[g][rr])
    }
  }
  rpt_vec(
    df,
    [2.0, 1.0, 4.0, 3.0, 1.0, 2.0, 4.0, 3.0, 2.0, 1.0, 4.0, 3.0, 1.0, 2.0,
      4.0, 3.0],
  )
  rpt_vec(
    uf,
    [3.0, 4.0, 1.0, 2.0, 3.0, 4.0, 1.0, 2.0, 4.0, 3.0, 1.0, 2.0, 4.0, 3.0,
      1.0, 2.0],
  )
  assert_true(rpt_raises(fn() {
    let _ = @src.rankprod_ori_rank(gr1=gr1, gr2=[[1.0]])
  }))
}

// ---------------------------------------------------------------------------
// Exact p-value machinery grids.
// ---------------------------------------------------------------------------

test "rank_product_pvalue_bounds matches rankprodbounds (n=12, k=5)" {
  let cases = [
    (1.0, 4.01877572016461e-06, 4.01877572016461e-06, 4.01877572016461e-06),
    (2.0, 9.00066792800889e-03, 1.45285879111767e-03, 3.61617194352517e-03),
    (3.62968, 2.06058678210853e-01, 8.22486304619585e-02,
      1.30184653771649e-01),
    (8.0, 9.44847893951187e-01, 8.80353813163381e-01, 9.12030945911002e-01),
    (12.0, 1.0, 1.0, 1.0),
  ]
  for c in cases {
    let (rank, upper, lower, geom) = c
    let (u, l, g) = @src.rank_product_pvalue_bounds(rank, 12, 5)
    assert_true(rpt_approx(u, upper, tol=1.0e-12))
    assert_true(rpt_approx(l, lower, tol=1.0e-12))
    assert_true(rpt_approx(g, geom, tol=1.0e-12))
    assert_true(rpt_approx(@src.rank_product_pvalue(rank, 12, 5), geom,
      tol=1.0e-12))
  }
}

test "rank_product_pvalue_bounds matches rankprodbounds (n=8, k=3)" {
  let cases = [
    (1.0, 1.95312500000000e-03),
    (1.5, 1.77606119137796e-02),
    (2.0, 7.51772588857313e-02),
    (4.0, 5.65299623017240e-01),
    (8.0, 1.00000000000000),
  ]
  for c in cases {
    let (rank, geom) = c
    let (_, _, g) = @src.rank_product_pvalue_bounds(rank, 8, 3)
    assert_true(rpt_approx(g, geom, tol=1.0e-12))
  }
  // Out-of-domain ranks raise.
  assert_true(rpt_raises(fn() {
    let _ = @src.rank_product_pvalue(0.0, 8, 3)
  }))
  assert_true(rpt_raises(fn() {
    let _ = @src.rank_product_pvalue(13.0, 12, 5)
  }))
}

test "rank_sum p-value/pmf match dice.sum grids (n=5, s=12)" {
  let cases = [
    (5.0, 4.01877572016461e-06, 4.01877572016461e-06),
    (10.0, 1.01273148148148e-03, 5.06365740740741e-04),
    (15.0, 1.20683834876543e-02, 4.02279449588477e-03),
    (26.0, 2.24127121913580e-01, 3.64703896604938e-02),
    (30.0, 4.00776427469136e-01, 4.78274498456790e-02),
    (40.0, 8.45100308641975e-01, 3.27570408950617e-02),
    (55.0, 9.99493634259259e-01, 5.06365740740710e-04),
    (60.0, 1.00000000000000, 4.01877572014670e-06),
  ]
  for c in cases {
    let (p, cdf, pdf) = c
    assert_true(rpt_approx(@src.rank_sum_pvalue(p, 5, 12), cdf, tol=1.0e-12))
    assert_true(rpt_approx(@src.rank_sum_pmf(p, 5, 12), pdf, tol=1.0e-12))
  }
  // Distribution symmetry: CDF at the mean region sums to one overall.
  assert_true(
    rpt_approx(@src.rank_sum_pvalue(65.0, 5, 12), 1.0, tol=1.0e-12),
  )
}

// ---------------------------------------------------------------------------
// topGene.
// ---------------------------------------------------------------------------

test "rankprod_top_genes num_gene and cutoff match frozen topGene output" {
  let rp = @src.rank_products(
    data=rpt_mat_a(),
    cl=rpt_cl10(),
    random_pairs=1,
  )
  let (tn_down, tn_up) = @src.rankprod_top_genes(result=rp, num_gene=Some(3))
  rpt_ivec(tn_down.indices(), [7, 1, 2])
  rpt_ivec(tn_up.indices(), [12, 11, 6])
  // prettyNum digits = 4 fold changes.
  rpt_vec(tn_down.fold_change(), [0.2575, 0.2877, 0.5903])
  rpt_vec(tn_down.statistic(), [2.048, 2.787, 4.416])
  rpt_vec(
    tn_down.p_value(),
    [0.0021, 0.0177, 0.1767],
  )
  rpt_vec(tn_down.pfp(), [0.0294, 0.1239, 0.8246])
  let (tc_down, tc_up) = @src.rankprod_top_genes(
    result=rp,
    cutoff=Some(0.5),
    method="pfp",
  )
  rpt_ivec(tc_down.indices(), [7, 1])
  rpt_ivec(tc_up.indices(), [12, 11])
  // pval method also selects the top down gene (p = 0.0021 < 0.01).
  let (tp_down, _) = @src.rankprod_top_genes(
    result=rp,
    cutoff=Some(0.01),
    method="pval",
  )
  rpt_ivec(tp_down.indices(), [7])
  // Error paths.
  assert_true(rpt_raises(fn() {
    let _ = @src.rankprod_top_genes(result=rp)
  }))
  assert_true(rpt_raises(fn() {
    let _ = @src.rankprod_top_genes(
      result=rp,
      cutoff=Some(0.5),
      num_gene=Some(3),
    )
  }))
  assert_true(rpt_raises(fn() {
    let _ = @src.rankprod_top_genes(
      result=rp,
      cutoff=Some(0.5),
      method="bogus",
    )
  }))
}

test "rank_products validates its inputs" {
  assert_true(rpt_raises(fn() {
    let _ = @src.rank_products(data=[], cl=[0, 1])
  }))
  assert_true(rpt_raises(fn() {
    let _ = @src.rank_products(data=[[1.0, 2.0]], cl=[0, 1, 2])
  }))
  assert_true(rpt_raises(fn() {
    let _ = @src.rank_products(
      data=[[1.0, 2.0, 3.0]],
      cl=[0, 1, 2],
    )
  }))
}
