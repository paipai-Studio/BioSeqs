}

// ---------------------------------------------------------------------------
// Dataset A: two-class logged rank product, one observed pairing.
// ---------------------------------------------------------------------------

test "RankProd A: two-class logged RP matches frozen output" {
  let rp = @src.rank_products(
    data=rpt_mat_a(),
    cl=rpt_cl10(),
    random_pairs=1,
  )
  rpt_vec(
    rp.statistic_down(),
    [
      6.24570238182, 2.78651802273, 4.41633344490, 7.99960933685,
      5.30456600928, 7.73272817973, 8.13556162437, 2.04767251108,
      7.79611968183, 4.61789292742, 6.64539805949, 12.3412747823,
      13.1784642994, 5.33255999712,
    ],
  )
  rpt_vec(
    rp.statistic_up(),
    [
      6.34649155922, 11.3958588458, 8.88719366776, 5.82738691715,
      5.75265209551, 5.55551042771, 5.33453721679, 12.5430238979,
      6.76557345342, 9.86859144472, 7.73675145359, 2.29739670999,
      1.64375182952, 5.57965487178,
    ],
  )
  rpt_vec(
    rp.p_value_down(),
    [
      5.15330044480e-01, 1.76966864712e-02, 1.76691779475e-01,
      7.93536708179e-01, 3.33083369823e-01, 7.59572701443e-01,
      8.09632146286e-01, 2.09982743386e-03, 7.67926632849e-01,
      2.09186038273e-01, 5.89054964289e-01, 9.98431042133e-01,
      9.99857482372e-01, 3.38440870229e-01,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rp.p_value_up(),
    [
      5.34325802646e-01, 9.91370066851e-01, 8.84365970113e-01,
      4.34613008949e-01, 4.20020734417e-01, 3.81549112143e-01,
      3.38819843550e-01, 9.99019526825e-01, 6.10254908225e-01,
      9.48344323566e-01, 7.60108235129e-01, 4.91904789005e-03,
      3.41540595060e-04, 3.86251188465e-01,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rp.pfp_down(),
    [
      1.03066008896, 0.123876805298, 0.824561637550, 1.00995581041,
      0.932633435504, 1.18155753558, 0.944570837334, 0.0293975840740,
      1.07509728599, 0.732151133956, 1.03084618751, 1.07523342999,
      0.999857482372, 0.789695363867,
    ],
    tol=1.0e-9,
  )
  rpt_vec(
    rp.pfp_up(),
    [
      0.935070154630, 1.06762930276, 1.12555668923, 0.869226017897,
      0.980048380307, 1.33542189250, 1.58115926990, 0.999019526825,
      0.949285412794, 1.10640171083, 1.06415152918, 0.0344333352303,
      0.00478156833084, 1.08150332770,
    ],
    tol=1.0e-9,
  )
  rpt_vec(
    rp.rank_down().map(fn(v) { v }),
    [7.0, 2.0, 3.0, 11.0, 5.0, 9.0, 12.0, 1.0, 10.0, 4.0, 8.0, 13.0, 14.0,
      6.0],
  )
  rpt_vec(
    rp.rank_up(),
    [8.0, 13.0, 11.0, 7.0, 6.0, 4.0, 3.0, 14.0, 9.0, 12.0, 10.0, 2.0, 1.0,
      5.0],
  )
  rpt_vec(
    rp.average_fold_change(),
    [
      -0.486580, -1.79756, -0.760400, 0.212880, -0.190880, 0.144120,
      0.867760, -1.95730, 0.352840, -0.680920, -0.145200, 2.18434, 2.32656,
      -0.0997600,
    ],
    tol=1.0e-5,
  )
  assert_eq(rp.nrep(), 5)
  assert_eq(rp.n_features(), 14)
  assert_eq(rp.n_valid(), 14)
  assert_eq(rp.random_pairs(), 1)
  assert_true(rp.is_rank_product())
  rpt_ivec(rp.groups(), rpt_cl10())
  // With one pairing the product matrix holds exactly the RPs.
  assert_eq(rp.products_down().length(), 1)
  rpt_vec(rp.products_down()[0], rp.statistic_down())
}

// ---------------------------------------------------------------------------
// Dataset B: same data, rank sum.
// ---------------------------------------------------------------------------

test "RankProd B: two-class logged RS matches frozen output" {
  let rs = @src.rank_products(
    data=rpt_mat_a(),
    cl=rpt_cl10(),
    calculate_product=false,
    random_pairs=1,
  )
  rpt_vec(
    rs.statistic_down(),
    [
      7.60, 3.40, 5.60, 8.40, 7.20, 8.60, 9.00, 2.40, 8.00, 5.00, 7.00,
      12.4, 13.2, 7.20,
    ],
  )
  rpt_vec(
    rs.statistic_up(),
    [
      7.40, 11.6, 9.40, 6.60, 7.80, 6.40, 6.00, 12.6, 7.00, 10.0, 8.00, 2.60,
      1.80, 7.80,
    ],
  )
  rpt_vec(
    rs.p_value_down(),
    [
      5.42820699708e-01, 1.15056226572e-02, 1.64124323199e-01,
      7.05226988755e-01, 4.57179300292e-01, 7.41605060392e-01,
      8.07111620158e-01, 1.47260070209e-03, 6.26651097757e-01,
      9.44918783840e-02, 4.14814139942e-01, 9.98527399298e-01,
      9.99895876718e-01, 4.57179300292e-01,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rs.p_value_up(),
    [
      5.00000000000e-01, 9.91878384007e-01, 8.61860013685e-01,
      3.33205658357e-01, 5.85185860058e-01, 2.94773011245e-01,
      2.24359641816e-01, 9.99140982924e-01, 4.14814139942e-01,
      9.23313202832e-01, 6.26651097757e-01, 2.39297614089e-03,
      2.34277384423e-04, 5.85185860058e-01,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rs.pfp_down(),
    [
      0.949936224490, 0.0805393586006, 0.574435131195, 0.987317784257,
      1.06675170068, 0.943860985953, 0.941630223518, 0.0206164098292,
      0.974790596511, 0.440962099125, 1.16147959184, 1.07533719924,
      0.999895876718, 0.914358600583,
    ],
    tol=1.0e-9,
  )
  rpt_vec(
    rs.pfp_up(),
    [
      1.00000000000, 1.06817672124, 1.09691274469, 0.932975843393,
      1.02407525510, 1.03170553936, 1.04701166181, 0.999140982924,
      0.967899659864, 1.07719873664, 0.877311536860, 0.0167508329863,
      0.00327988338192, 0.910289115646,
    ],
    tol=1.0e-9,
  )
  // Ties at RS 7.2 share average rank 6.5.
  rpt_vec(
    rs.rank_down(),
    [8.0, 2.0, 4.0, 10.0, 6.5, 11.0, 12.0, 1.0, 9.0, 3.0, 5.0, 13.0, 14.0,
      6.5],
  )
  rpt_vec(
    rs.rank_up(),
    [7.0, 13.0, 11.0, 5.0, 8.5, 4.0, 3.0, 14.0, 6.0, 12.0, 10.0, 2.0, 1.0,
      8.5],
  )
  assert_true(!rs.is_rank_product())
}

// ---------------------------------------------------------------------------
// Dataset C: unlogged raw-scale input.
// ---------------------------------------------------------------------------

test "RankProd C: unlogged raw ratios match frozen output" {
  let rp = @src.rank_products(
    data=rpt_mat_c(),
    cl=rpt_cl10(),
    logged=false,
    random_pairs=1,
  )
  // Rank ordering of log10 raw ratios matches the logged fixture.
  rpt_vec(
    rp.statistic_down(),
    [
      6.24570238182, 2.78651802273, 4.41633344490, 7.99960933685,
      5.30456600928, 7.73272817973, 8.13556162437, 2.04767251108,
      7.79611968183, 4.61789292742, 6.64539805949, 12.3412747823,
      13.1784642994, 5.33255999712,
    ],
  )
  rpt_vec(
    rp.statistic_up(),
    [
      6.34649155922, 11.3958588458, 8.88719366776, 5.82738691715,
      5.75265209551, 5.55551042771, 5.33453721679, 12.5430238979,
      6.76557345342, 9.86859144472, 7.73675145359, 2.29739670999,
      1.64375182952, 5.57965487178,
    ],
  )
  rpt_vec(rp.p_value_down(), [
      5.15330044480e-01, 1.76966864712e-02, 1.76691779475e-01,
      7.93536708179e-01, 3.33083369823e-01, 7.59572701443e-01,
      8.09632146286e-01, 2.09982743386e-03, 7.67926632849e-01,
      2.09186038273e-01, 5.89054964289e-01, 9.98431042133e-01,
      9.99857482372e-01, 3.38440870229e-01,
    ], tol=1.0e-10)
  rpt_vec(
    rp.average_fold_change(),
    [
      1.04097521000, 0.277542608502, 0.528719362289, 1.02824904292,
      0.907912646503, 1.35618405343, 1.47652822023, 0.282513417864,
      1.25368482135, 0.570401186791, 0.938765911162, 4.16685348279,
      4.65209343323, 0.932352507840,
    ],
    tol=1.0e-8,
  )
}

// ---------------------------------------------------------------------------
// Dataset D: one-class paired analysis; the up direction ranks raw 1/x.
// ---------------------------------------------------------------------------

test "RankProd D: one-class paired RP matches frozen output" {
  let rp = @src.rank_products(
    data=rpt_mat_d(),
    cl=rpt_cl6_one(),
    random_pairs=1,
  )
  rpt_vec(
    rp.statistic_down(),
    [
      2.37617679756, 4.57885697021, 5.03020675112, 4.09334062307,
      3.65905165332, 4.97269663250, 3.53277552900, 5.03020675112,
      6.67182681009, 7.50855444520,
    ],
  )
  // First up rank 7.74597 = sqrt(60) distinguishes 1/x from negation when
  // log values cross zero.
  rpt_vec(
    rp.statistic_up(),
    [
      7.74596669241, 4.99609906593, 4.03565430873, 6.19357536430,
      4.56079359657, 4.97269663250, 4.90931997753, 4.03565430873,
      3.32200191233, 2.51323687655,
    ],
  )
  rpt_vec(
    rp.p_value_down(),
    [
      1.64789654630e-02, 4.88011038196e-01, 6.19499357313e-01,
      3.40095487914e-01, 2.17031723385e-01, 6.03530110384e-01,
      1.85108228912e-01, 6.19499357313e-01, 9.23214986497e-01,
      9.77588074356e-01,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rp.p_value_up(),
    [
      9.85380987730e-01, 6.10062498348e-01, 3.22891658358e-01,
      8.65821797351e-01, 4.82530526885e-01, 6.03530110384e-01,
      5.85616364152e-01, 3.22891658358e-01, 1.37145799619e-01,
      2.48978634482e-02,
    ],
    tol=1.0e-10,
  )
  rpt_vec(
    rp.pfp_down(),
    [
      0.164789654630, 0.976022076391, 0.884999081876, 0.850238719785,
      0.723439077951, 1.00588351731, 0.925541144559, 0.774374196642,
      1.02579442944, 0.977588074356,
    ],
    tol=1.0e-9,
  )
  rpt_vec(
    rp.pfp_up(),
    [
      0.985380987730, 0.762578122934, 1.07630552786, 0.962024219279,
      0.965061053771, 0.862185871977, 0.976027273587, 0.807229145895,
      0.685728998095, 0.248978634482,
    ],
    tol=1.0e-9,
  )
  rpt_vec(
    rp.average_fold_change(),
    [
      -0.484916666667, 1.11206666667, 1.35030, 0.682166666667, 0.36345,
      0.604766666667, 0.485383333333, 0.782166666667, 1.44650, 1.39083333333,
    ],
    tol=1.0e-8,
  )
  assert_eq(rp.nrep(), 6)
  assert_eq(rp.random_pairs(), 1)
  rpt_ivec(rp.groups(), rpt_cl6_one())
}

