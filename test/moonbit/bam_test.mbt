///|
/// Test BAM format parsing (standard htslib layout), auxiliary tags, flags,
/// and CIGAR strings. The fixture is a real pysam-generated BAM (BGZF
/// decompressed) with three reads covering various tag types.

///|
/// Base64-encoded raw BAM generated by pysam 0.24.1:
///   read1: 8M, tags NM:i:0 MD:Z:8 AS:i:8 XS:A:+
///   read2: 4M1I, flag 0x400|0x200, tags NM:i:1 AS:f:4.5 RG:Z:grp1 XA:B:i:1,2,3
///   read3: 6M, flag 0x10, tags MC:c:1 SC:C:250 SI:s:-3 UI:S:60000
let test_bam_base64 = ""


///|
test "bam_parse_header" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  assert_eq(bam.num_references(), 1)
  let ref_names = bam.get_reference_names()
  assert_eq(ref_names.length(), 1)
  assert_eq(ref_names[0], "chr1")
  assert_eq(bam.get_reference_length("chr1"), Some(1000))
}

///|
test "bam_parse_records_standard_layout" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  assert_eq(bam.len(), 3)

  let r1 = bam.records[0]
  assert_eq(r1.qname, "read1")
  assert_eq(r1.flag, 3)
  assert_eq(r1.ref_id, 0)
  assert_eq(r1.pos, 100)
  assert_eq(r1.mapq, 60)
  assert_eq(r1.l_seq, 8)
  assert_eq(r1.cigar.length(), 1)
  assert_eq(r1.cigar[0].length, 8)
  assert_eq(r1.seq, "ACGTACGT")
  assert_eq(r1.qual, "!!!!!!!!")

  let r2 = bam.records[1]
  assert_eq(r2.qname, "read2")
  assert_eq(r2.flag, 1536)
  assert_eq(r2.pos, 200)
  assert_eq(r2.mapq, 20)
  assert_eq(r2.seq, "ACGTA")
  assert_eq(r2.cigar.length(), 2)

  let r3 = bam.records[2]
  assert_eq(r3.qname, "read3")
  assert_eq(r3.flag, 16)
  assert_eq(r3.pos, 300)
  assert_eq(r3.mapq, 40)
  assert_eq(r3.seq, "NNNNNN")
}

///|
test "bam_aux_tags" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  let r1 = bam.records[0]
  match r1.get_tag("NM") {
    Some(@src.BamTagValue::Int(v)) => assert_eq(v, 0)
    _ => abort("NM should be int 0")
  }
  match r1.get_tag("MD") {
    Some(@src.BamTagValue::Str(v)) => assert_eq(v, "8")
    _ => abort("MD should be string 8")
  }
  match r1.get_tag("AS") {
    Some(@src.BamTagValue::Int(v)) => assert_eq(v, 8)
    _ => abort("AS should be int 8")
  }
  match r1.get_tag("XS") {
    Some(@src.BamTagValue::Char(c)) => assert_eq(c, '+')
    _ => abort("XS should be char +")
  }

  let r2 = bam.records[1]
  match r2.get_tag("AS") {
    Some(@src.BamTagValue::Float(v)) => assert_true(assert_close_e6(v, 4.5))
    _ => abort("AS should be float 4.5")
  }
  match r2.get_tag("RG") {
    Some(@src.BamTagValue::Str(v)) => assert_eq(v, "grp1")
    _ => abort("RG should be string grp1")
  }
  match r2.get_tag("XA") {
    Some(@src.BamTagValue::IntArray(a)) => {
      assert_eq(a.length(), 3)
      assert_eq(a[0], 1)
      assert_eq(a[1], 2)
      assert_eq(a[2], 3)
    }
    _ => abort("XA should be int array [1,2,3]")
  }

  let r3 = bam.records[2]
  match r3.get_tag("MC") {
    Some(@src.BamTagValue::Int(v)) => assert_eq(v, 1)
    _ => abort("MC should be int 1")
  }
  match r3.get_tag("SC") {
    Some(@src.BamTagValue::Int(v)) => assert_eq(v, 250)
    _ => abort("SC should be int 250")
  }
  match r3.get_tag("SI") {
    Some(@src.BamTagValue::Int(v)) => assert_eq(v, -3)
    _ => abort("SI should be int -3")
  }
  match r3.get_tag("UI") {
    Some(@src.BamTagValue::Int(v)) => assert_eq(v, 60000)
    _ => abort("UI should be int 60000")
  }
}

///|
test "bam_flag_duplicate_qcfail" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  let r2 = bam.records[1]
  assert_true(r2.is_duplicate())
  assert_true(r2.is_qcfail())
  assert_true(r2.is_unmapped() == false)
  assert_true(r2.is_reverse() == false)

  let r3 = bam.records[2]
  assert_true(r3.is_reverse())
  assert_true(r3.is_duplicate() == false)
  assert_true(r3.is_qcfail() == false)
}

///|
test "bam_cigarstring" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  assert_eq(bam.records[0].cigarstring(), "8M")
  assert_eq(bam.records[1].cigarstring(), "4M1I")
  assert_eq(bam.records[2].cigarstring(), "6M")
}

///|
test "bam_get_reference_name" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  assert_eq(bam.records[0].get_reference_name(bam.header), "chr1")
}

///|
test "bam_alignment_stats" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  // read1: pos 100, 8M -> end 107 (0-based exclusive-ish, per existing impl)
  assert_eq(bam.records[0].get_end(), 107)
  assert_eq(bam.records[0].get_alignment_length(), 8)
}

///|
test "bam_to_sam_string" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  let sam_str = bam.records[0].to_sam_string(bam.header)
  assert_true(sam_str.find("read1") is Some(_))
  assert_true(sam_str.find("chr1") is Some(_))
  assert_true(sam_str.find("8M") is Some(_))
}

///|
test "bam_to_sam" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  let sam_str = bam.to_sam()
  assert_true(sam_str.find("@HD") is Some(_))
  assert_true(sam_str.find("@SQ") is Some(_))
  assert_true(sam_str.find("read1") is Some(_))
}

///|
test "bam_base64_decode" {
  let encoded = "YWJj"
  let decoded = @src.base64_decode(encoded)
  assert_eq(decoded.length(), 3)
  assert_eq(decoded.unsafe_get(0).to_int(), 97)
  assert_eq(decoded.unsafe_get(1).to_int(), 98)
  assert_eq(decoded.unsafe_get(2).to_int(), 99)
}

///|
test "bam_debug_magic" {
  let raw_data = @src.base64_decode(test_bam_base64)
  assert_eq(raw_data.length() >= 4, true)
  let magic_ok = @src.is_bam_magic(raw_data)
  assert_true(magic_ok)
}
///|
test "bam_negative_int32_fields" {
  // next mate coordinates default to -1 (0xFFFFFFFF); confirm 32-bit two's
  // complement reads them as -1, not a huge unsigned value.
  let bam = @src.parse_bam_base64(test_bam_base64)
  assert_eq(bam.records[0].next_ref_id, -1)
  assert_eq(bam.records[0].next_pos, -1)
  assert_eq(bam.records[0].tlen, 0)
}
///|
test "bam_write_roundtrip" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  // uncompressed BAM bytes round-trip
  let raw = bam.to_bam_bytes()
  let bam2 = @src.parse_bam(raw)
  assert_eq(bam2.to_sam(), bam.to_sam())
  // BGZF-compressed BAM round-trip (through bgzf_compress/decompress)
  let bgzf = bam.to_bgzf_bytes()
  let bam3 = @src.parse_bam_from_bgzf(bgzf)
  assert_eq(bam3.to_sam(), bam.to_sam())
}

// ============================================================
// samtools 子命令：sort / merge / depth / fastq
// ============================================================

test "bam_sort" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  // 手工乱序：swap 0 和 2（pos 100 与 300）
  let recs = bam.records.copy()
  let tmp = recs[0]
  recs[0] = recs[2]
  recs[2] = tmp
  let shuffled = @src.BamFile::new(bam.header, recs)
  let sorted = @src.bam_sort(shuffled)
  assert_eq(sorted.records[0].pos, 100)
  assert_eq(sorted.records[1].pos, 200)
  assert_eq(sorted.records[2].pos, 300)
}

test "bam_merge" {
  let bam1 = @src.parse_bam_base64(test_bam_base64)
  let bam2 = @src.parse_bam_base64(test_bam_base64)
  let merged = @src.bam_merge([bam1, bam2])
  assert_eq(merged.records.length(), 6)
}

test "bam_depth" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  // read1 [100,108) read2 [200,204) read3 [300,306)（0-based），深度 1
  let d = @src.bam_depth(bam, "chr1")
  assert_eq(d.length(), 8 + 4 + 6)
  assert_eq(d[0], (101, 1))
  assert_eq(d[7], (108, 1))
  // read2 起点
  assert_eq(d[8], (201, 1))
}

test "bam_fastq" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  let fq = @src.bam_fastq(bam)
  assert_true(fq.contains("@read1"))
  assert_true(fq.contains("ACGTACGT"))  // read1 序列
  assert_true(fq.contains("@read3"))
}


// ============================================================
// samtools 子命令：markdup / stats
// ============================================================

test "bam_markdup" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  // read1 两次 + read2（制造重复）
  let recs = [bam.records[0], bam.records[0], bam.records[2]]
  let dup_bam = @src.BamFile::new(bam.header, recs)
  let marked = @src.bam_markdup(dup_bam)
  // 第一个 read1 不标，第二个 read1 标 dup，read3 不标
  assert_true(not(marked.records[0].is_duplicate()))
  assert_true(marked.records[1].is_duplicate())
  assert_true(not(marked.records[2].is_duplicate()))
}

test "bam_stats" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  let s = @src.bam_stats(bam)
  assert_eq(s.total_reads, 3)
  assert_eq(s.mapped_reads, 3)
  assert_eq(s.duplicate_reads, 1)  // read2 是 duplicate
  // 平均读长 (8 + 5 + 6) / 3
  assert_true(assert_close(s.avg_read_length, 19.0 / 3.0, 1.0e-9))
}


// ============================================================
// pysam 高频访问：fetch / count_coverage / get_base_counts
// ============================================================

test "bam_fetch" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  // read1 覆盖 [100,108)，read2 [200,204)，read3 [300,306)
  let hits = @src.bam_fetch(bam, "chr1", 0, 150)
  assert_eq(hits.length(), 1)
  assert_eq(hits[0].qname, "read1")
  // 缩小到 [0,100) → 无（read1 起点是 100，半开不重叠）
  let none = @src.bam_fetch(bam, "chr1", 0, 100)
  assert_eq(none.length(), 0)
}

test "bam_count_coverage" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  // read1 seq=ACGTACGT 覆盖 [100,108)
  let (a, c, g, t) = @src.bam_count_coverage(bam, "chr1", 100, 108)
  assert_eq(a.length(), 8)
  assert_eq(a[0], 1)  // pos100 = A
  assert_eq(c[1], 1)  // pos101 = C
  assert_eq(g[2], 1)  // pos102 = G
  assert_eq(t[3], 1)  // pos103 = T
  assert_eq(a[4], 1)  // pos104 = A
}

test "bam_get_base_counts" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  assert_eq(@src.bam_get_base_counts(bam, "chr1", 100), (1, 0, 0, 0))  // A
  assert_eq(@src.bam_get_base_counts(bam, "chr1", 101), (0, 1, 0, 0))  // C
}


// ============================================================
// get_alignment_quality
// ============================================================

test "bam_alignment_quality" {
  let bam = @src.parse_bam_base64(test_bam_base64)
  // read1：mapq=60，NM:i:0 → quality = 60
  assert_true(assert_close(@src.bam_alignment_quality(bam.records[0]), 60.0, 1.0e-9))
}
