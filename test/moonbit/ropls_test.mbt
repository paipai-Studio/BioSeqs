///|
test "ropls PCA: pca3" {
  let m = @src.ropls_pca(ropls_x, ncomp=3)
  assert_eq(m.ncomp, e_pca3_ncomp)
  assert_true(ropls_mat_close(m.scores, e_pca3_T, 1.0e-9))
  assert_true(ropls_mat_close(m.loadings, e_pca3_P, 1.0e-9))
  assert_true(ropls_vec_close(m.variance, e_pca3_var, 1.0e-9))
  assert_true(ropls_vec_close(m.r2x, e_pca3_r2x, 6.0e-3))
  assert_true(ropls_vec_close(m.r2x_cum, e_pca3_r2xc, 6.0e-3))
  assert_eq(m.iters, e_pca3_iters)
  assert_true(ropls_vec_close(m.x_mean, e_pca3_xmean, 1.0e-9))
  assert_true(ropls_vec_close(m.x_sd, e_pca3_xsd, 1.0e-9))
}

