///|
test "ropls PLS-DA: lexicographic class levels and classification" {
  let m = @src.ropls_fit(ropls_x, y=@src.RoplsY::Classes(ropls_g3), ncomp=2)
  assert_eq(m.classes, ["ctrl", "high", "low"])
  assert_eq(m.kind, "PLS-DA")
}

///|
test "ropls predict: continuous response on new X rows" {
  let m = @src.ropls_fit(ropls_x, y=@src.RoplsY::Continuous(ropls_y1), ncomp=2)
  let sub6 : Array[Array[Double]] = Array(capacity=0)
  for i in 0..<6 {
    sub6.push(ropls_x[i])
  }
  let pn = @src.ropls_predict(m, sub6)
  assert_true(ropls_mat_close(pn, e_pred_new, 1.0e-9))
}

///|
test "ropls predict: class labels on new X rows" {
  let m = @src.ropls_fit(ropls_x, y=@src.RoplsY::Classes(ropls_g3), ncomp=2)
  let sub9 : Array[Array[Double]] = Array(capacity=0)
  for i in 0..<9 {
    sub9.push(ropls_x[i])
  }
  let pd = @src.ropls_predict_classes(m, sub9)
  assert_eq(pd, e_pred_da)
}

///|
test "ropls permutation: perm" {
  let pr = @src.ropls_permutation(
    ropls_x,
    y=@src.RoplsY::Continuous(ropls_y1),
    perms=ropls_perms,
    ncomp=1,
  )
  assert_true(ropls_vec_close(pr.perm_r2y, e_perm_r2y, 6.0e-3))
  assert_true(ropls_vec_close(pr.perm_q2, e_perm_q2, 6.0e-3))
  assert_true(ropls_vec_close(pr.sim, e_perm_sim, 1.0e-9))
  assert_true(ropls_close(pr.obs_r2y, e_perm_obsr2y, 6.0e-3))
  assert_true(ropls_close(pr.obs_q2, e_perm_obsq2, 6.0e-3))
  assert_true(ropls_close(pr.p_r2y, e_perm_pr2y, 1.0e-9))
  assert_true(ropls_close(pr.p_q2, e_perm_pq2, 1.0e-9))
}

///|
test "ropls permutation: permd" {
  let pr = @src.ropls_permutation(
    ropls_x,
    y=@src.RoplsY::Classes(ropls_g3),
    perms=ropls_permds,
    ncomp=2,
  )
  assert_true(ropls_vec_close(pr.perm_r2y, e_permd_r2y, 6.0e-3))
  assert_true(ropls_vec_close(pr.perm_q2, e_permd_q2, 6.0e-3))
  assert_true(ropls_vec_close(pr.sim, e_permd_sim, 1.0e-9))
  assert_true(ropls_close(pr.obs_r2y, e_permd_obsr2y, 6.0e-3))
  assert_true(ropls_close(pr.obs_q2, e_permd_obsq2, 6.0e-3))
  assert_true(ropls_close(pr.p_r2y, e_permd_pr2y, 1.0e-9))
  assert_true(ropls_close(pr.p_q2, e_permd_pq2, 1.0e-9))
}

///|
test "ropls input validation rejects invalid calls" {
  let ragged : Array[Array[Double]] = [[1.0, 2.0], [3.0]]
  let ok1 = try {
    ignore(@src.ropls_pca(ragged))
    false
  } catch {
    _ => true
  }
  let one : Array[String] = []
  for i in 0..<ropls_x.length() {
    one.push("same")
  }
  let ok2 = try {
    ignore(@src.ropls_fit(ropls_x, y=@src.RoplsY::Classes(one), ncomp=1))
    false
  } catch {
    _ => true
  }
  let bad_y : Array[Array[Double]] = [ropls_y1[0]]
  let ok3 = try {
    ignore(@src.ropls_fit(ropls_x, y=@src.RoplsY::Continuous(bad_y), ncomp=1))
    false
  } catch {
    _ => true
  }
  let ok4 = try {
    ignore(
      @src.ropls_fit(
        ropls_x,
        y=@src.RoplsY::Continuous(ropls_y2),
        ncomp=1,
        ortho=1,
      ),
    )
    false
  } catch {
    _ => true
  }
  let ok5 = try {
    ignore(
      @src.ropls_fit(
        ropls_x,
        y=@src.RoplsY::Classes(ropls_g3),
        ncomp=1,
        ortho=1,
      ),
    )
    false
  } catch {
    _ => true
  }
  let ok6 = try {
    ignore(@src.ropls_pca(ropls_x, ncomp=2, scale="weird"))
    false
  } catch {
    _ => true
  }
  let empty_perms : Array[Array[Int]] = Array(capacity=0)
  let ok7 = try {
    ignore(
      @src.ropls_permutation(
        ropls_x,
        y=@src.RoplsY::Continuous(ropls_y1),
        perms=empty_perms,
        ncomp=1,
      ),
    )
    false
  } catch {
    _ => true
  }
  let pls = @src.ropls_fit(
    ropls_x,
    y=@src.RoplsY::Continuous(ropls_y1),
    ncomp=1,
  )
  let ok8 = try {
    ignore(@src.ropls_predict_classes(pls, ropls_x))
    false
  } catch {
    _ => true
  }
  assert_true(ropls_raises(ok1))
  assert_true(ok2)
  assert_true(ok3)
  assert_true(ok4)
  assert_true(ok5)
  assert_true(ok6)
  assert_true(ok7)
  assert_true(ok8)
}
