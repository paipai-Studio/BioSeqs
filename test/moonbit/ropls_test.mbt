///|
test "ropls model: pls1_2" {
  let m = @src.ropls_fit(ropls_x, y=@src.RoplsY::Continuous(ropls_y1), ncomp=2)
  assert_true(ropls_mat_close(m.scores, e_pls1_2_T, 1.0e-9))
  assert_true(ropls_mat_close(m.x_loadings, e_pls1_2_P, 1.0e-9))
  assert_true(ropls_mat_close(m.weights, e_pls1_2_W, 1.0e-9))
  assert_true(ropls_mat_close(m.weight_star, e_pls1_2_R, 1.0e-9))
  assert_true(ropls_mat_close(m.y_scores, e_pls1_2_U, 1.0e-9))
  assert_true(ropls_mat_close(m.y_loadings, e_pls1_2_C, 1.0e-9))
  assert_true(ropls_mat_close(m.coefficients, e_pls1_2_B, 1.0e-9))
  assert_true(ropls_mat_close(m.ortho_scores, e_pls1_2_To, 1.0e-9))
  assert_true(ropls_mat_close(m.ortho_loadings, e_pls1_2_Po, 1.0e-9))
  assert_true(ropls_mat_close(m.ortho_weights, e_pls1_2_Wo, 1.0e-9))
  assert_true(ropls_mat_close(m.ortho_y_loadings, e_pls1_2_Co, 1.0e-9))
  assert_true(ropls_mat_close(m.y_pred, e_pls1_2_ypred, 1.0e-9))
  assert_true(ropls_vec_close(m.vip, e_pls1_2_vip, 1.0e-9))
  assert_true(ropls_vec_close(m.ortho_vip, e_pls1_2_ovip, 1.0e-9))
  assert_true(ropls_vec_close(m.x_mean, e_pls1_2_xmean, 1.0e-9))
  assert_true(ropls_vec_close(m.x_sd, e_pls1_2_xsd, 1.0e-9))
  assert_true(ropls_vec_close(m.y_mean, e_pls1_2_ymean, 1.0e-9))
  assert_true(ropls_vec_close(m.y_sd, e_pls1_2_ysd, 1.0e-9))
  assert_true(ropls_vec_close(m.r2x, e_pls1_2_r2x, 6.0e-3))
  assert_true(ropls_vec_close(m.r2x_cum, e_pls1_2_r2xc, 6.0e-3))
  assert_true(ropls_vec_close(m.r2y, e_pls1_2_r2y, 6.0e-3))
  assert_true(ropls_vec_close(m.r2y_cum, e_pls1_2_r2yc, 6.0e-3))
  assert_true(ropls_vec_close(m.q2, e_pls1_2_q2, 6.0e-3))
  assert_true(ropls_vec_close(m.q2_cum, e_pls1_2_q2c, 6.0e-3))
  assert_eq(m.significance, e_pls1_2_sig)
  assert_eq(m.pre, e_pls1_2_pre)
  assert_eq(m.ort, e_pls1_2_ort)
  let mt = [m.total_r2x, m.total_r2y, m.total_q2, m.rmsee]
  assert_true(ropls_vec_close(mt, e_pls1_2_tot, 6.0e-3))
}

///|
test "ropls model: pls1_1" {
  let m = @src.ropls_fit(ropls_x, y=@src.RoplsY::Continuous(ropls_y1), ncomp=1)
  assert_true(ropls_mat_close(m.scores, e_pls1_1_T, 1.0e-9))
  assert_true(ropls_mat_close(m.x_loadings, e_pls1_1_P, 1.0e-9))
  assert_true(ropls_mat_close(m.weights, e_pls1_1_W, 1.0e-9))
  assert_true(ropls_mat_close(m.weight_star, e_pls1_1_R, 1.0e-9))
