///|
/// ropls port: values are fixed outputs of Bioconductor ropls 1.34.0
/// (NIPALS algorithms) on a deterministic synthetic dataset (R set.seed(42),
/// n = 24 samples, p = 6 variables), generated by /tmp/gen_ropls_test.py.

///|
fn ropls_close(a : Double, b : Double, tol : Double) -> Bool {
  if a.is_nan() {
    b.is_nan()
  } else if b.is_nan() {
    false
  } else {
    (a - b).abs() < tol
  }
}

///|
fn ropls_vec_close(a : Array[Double], b : Array[Double], tol : Double) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i in 0..<a.length() {
    if not(ropls_close(a[i], b[i], tol)) {
      return false
    }
  }
  true
}

///|
fn ropls_mat_close(
  a : Array[Array[Double]],
  b : Array[Array[Double]],
  tol : Double,
) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i in 0..<a.length() {
    if a[i].length() != b[i].length() {
      return false
    }
    for j in 0..<a[i].length() {
      if not(ropls_close(a[i][j], b[i][j], tol)) {
        return false
      }
    }
  }
  true
}

///|
fn ropls_raises(result : Bool) -> Bool {
  result
}

