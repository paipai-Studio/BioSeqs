// ========================================== unit spline internals (bs basis)

///|
fn sw_lambda19() -> Array[Double] {
  let v : Array[Double] = []
  let mut i = 1
  while i <= 19 {
    v.push(i.to_double() * 0.05)
    i = i + 1
  }
  v
}

///|
test "swfdr_unit_spline_matrix_l19" {
  let t = @src.swfdr_unit_spline_matrix(sw_lambda19(), 3)
  assert_eq(t.length(), 19)
  assert_eq(t[0].length(), 19)
  let last = [
    0.000772113474901703, -0.00400079298084407, -0.00840216926869293, -0.012755358317206,
    -0.0169389683048143, -0.0207137703255452, -0.0236846171130686, -0.0252666375170895,
    -0.024659478011998, -0.0208350981442252, -0.0125465844401726, 0.00163250492617454,
    0.0232268158397603, 0.0537229093980505, 0.0943642823254775, 0.145864536333906,
    0.208028044772332, 0.279272668119847, 0.362919599233309,
  ]
  sw_expect_row(t, 18, last, 1.0e-10)
  let b = @src.swfdr_bs_unit(sw_lambda19())
  assert_eq(b.length(), 19)
  assert_eq(b[0].length(), 22)
  let col0 = Array::make(19, 0.0)
  col0[0] = 0.25
  sw_expect_col(b, 0, col0, 1.0e-10)
  sw_expect_col(b, 21, Array::make(19, 0.0), 1.0e-10)
}

///|
test "swfdr_unit_spline_matrix_l8" {
  let t = @src.swfdr_unit_spline_matrix(sw_l8(), 3)
  let last = [
    -0.135915390555168, -0.0691565454370437, -0.00451967735604818, 0.0662218126946552,
    0.146277259997276, 0.237659878470613, 0.335217717794993, 0.424214944390679,
  ]
  sw_expect_row(t, 7, last, 1.0e-10)
  let b = @src.swfdr_bs_unit(sw_l8())
  assert_eq(b[0].length(), 11)
  let col0 = Array::make(8, 0.0)
  col0[0] = 0.25
  sw_expect_col(b, 0, col0, 1.0e-10)
  sw_expect_col(b, 10, Array::make(8, 0.0), 1.0e-10)
}

///|
fn sw_expect_col(
  m : Array[Array[Double]],
  col : Int,
  want : Array[Double],
  tol : Double,
) -> Unit raise {
  let v : Array[Double] = []
  let mut i = 0
  while i < m.length() {
    v.push(m[i][col])
    i = i + 1
  }
  sw_expect(v, want, tol)
}

///|
test "swfdr_design_matrix_helper" {
  let m = @src.swfdr_design_matrix([[1.0, 2.0], [3.0, 4.0]])
  assert_true(m is Some(_))
  let mm = match m {
    Some(v) => v
    None => abort("design matrix should be built")
  }
  assert_eq(mm.length(), 2)
  assert_eq(mm[0], [1.0, 3.0])
  assert_eq(mm[1], [2.0, 4.0])
  assert_true(@src.swfdr_design_matrix([]) is None)
  assert_true(@src.swfdr_design_matrix([[1.0, 2.0], [3.0]]) is None)
}

