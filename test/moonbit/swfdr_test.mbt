///|
/// truncated flags: positions 51-55 (1-based) are truncated upper bounds
fn sw_tt() -> Array[Int] {
  let v = Array::make(60, 0)
  let mut i = 50
  while i < 55 {
    v[i] = 1
    i = i + 1
  }
  v
}

///|
/// rounded flags: positions 41-50, 56, 57 (1-based) are rounded
fn sw_rr() -> Array[Int] {
  let v = Array::make(60, 0)
  let mut i = 40
  while i < 50 {
    v[i] = 1
    i = i + 1
  }
  v[55] = 1
  v[56] = 1
  v
}

