///|
test "swfdr_lm_pi0_pmax_warning_path" {
  // max(p) = 0.6 < max(lambda) = 0.9 only warns in R; computation proceeds
  let p = [0.01, 0.02, 0.03, 0.5, 0.6]
  let x = sw_cols([[0.0, 0.1, 0.2, 0.3, 0.4]])
  let lambda = [0.2, 0.375, 0.55, 0.725, 0.9]
  let r = @src.swfdr_lm_pi0(p, lambda=Some(lambda), x~)
  let want = [
    1.67937646407583e-10, 1.67937646407583e-10, 1.36565843505349e-10, 0.0, 0.0,
  ]
  sw_expect(r.pi0(), want, 1.0e-14)
}

