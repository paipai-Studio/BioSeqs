///|
fn blat_close(a : Double, b : Double) -> Bool {
  (a - b).abs() < 1.0e-9
}

///|
fn blat_parse_raises(content : String, pslx : Bool) -> Bool {
  try {
    ignore(@src.blat_psl_parse(content, pslx=pslx))
    false
  } catch {
    SeqError(_) => true
  }
}

///|
fn blat_write_raises(qresults : Array[@src.BlatQueryResult], pslx : Bool) -> Bool {
  try {
    ignore(@src.blat_psl_write(qresults, pslx=pslx))
    false
  } catch {
    SeqError(_) => true
  }
}

///|
let blat_nuc_text : String = "psLayout version 3\n\nmatch\tmis- \trep. \tN's\tQ gap\tQ gap\tT gap\tT gap\tstrand\tQ        \tQ   \tQ    \tQ  \tT        \tT   \tT    \tT  \tblock\tblockSizes \tqStarts\t tStarts\n     \tmatch\tmatch\t   \tcount\tbases\tcount\tbases\t      \tname     \tsize\tstart\tend\tname     \tsize\tstart\tend\tcount\n---------------------------------------------------------------------------------------------------------------------------------------------------------------\n40\t2\t1\t0\t1\t5\t1\t8\t+\tq1\t100\t10\t45\tchr1\t1000\t100\t138\t2\t20,10,\t10,35,\t100,128,\n27\t2\t1\t0\t2\t25\t2\t20\t--\tq1\t100\t10\t65\tchr2\t500\t100\t150\t3\t10,10,10,\t80,60,35,\t390,370,350,\n10\t0\t0\t0\t0\t0\t0\t0\t+\tq1\t100\t80\t90\tchr1\t1000\t200\t210\t1\t10,\t80,\t200,\n15\t1\t0\t1\t0\t0\t0\t0\t+\tq2\t80\t0\t16\tchr1\t1000\t500\t516\t1\t16,\t0,\t500,\n"

///|
let blat_mix_text : String = "5\t0\t0\t0\t0\t0\t0\t0\t-\tq2\t80\t16\t21\tchr3\t400\t0\t5\t1\t5,\t59,\t0,\n28\t1\t1\t0\t1\t0\t1\t0\t++\tq3\t40\t5\t35\tchrP\t300\t30\t150\t2\t10,20,\t5,15,\t30,90,\n"

///|
let blat_pslx_text : String = "18\t1\t1\t0\t1\t4\t0\t0\t+\tqx\t60\t5\t29\tchrA\t900\t50\t74\t2\t10,10,\t5,19,\t50,64,\tAAAAATTTTT,CCCCCGGGGG,\tAAAAATTT-T,CCCCCGGGGG,\n16\t2\t0\t0\t0\t0\t1\t6\t-+\tqx\t60\t38\t58\tchrB\t700\t100\t120\t2\t8,8,\t2,14,\t100,112,\tACGTACGT,TGCATGCA,\tAC-TACGT,TGC-TGCA,\n"

///|
let blat_header_text : String = "psLayout version 3\n\nmatch\tmis- \trep. \tN's\tQ gap\tQ gap\tT gap\tT gap\tstrand\tQ        \tQ   \tQ    \tQ  \tT        \tT   \tT    \tT  \tblock\tblockSizes \tqStarts\t tStarts\n     \tmatch\tmatch\t   \tcount\tbases\tcount\tbases\t      \tname     \tsize\tstart\tend\tname     \tsize\tstart\tend\tcount\n---------------------------------------------------------------------------------------------------------------------------------------------------------------\n"

test "blat-psl parse: nucleotide rows grouped into qresults and hits" {
  let nuc = @src.blat_psl_parse(blat_nuc_text) catch {
    _ => abort("valid PSL should parse")
  }
  assert_eq(nuc.length(), 2)
  assert_eq(nuc[0].id, "q1")
  assert_eq(nuc[0].seq_len, 100)
  assert_eq(nuc[0].program, "blat")
  assert_eq(nuc[0].hits.length(), 2)
  assert_eq(nuc[0].hits[0].id, "chr1")
  assert_eq(nuc[0].hits[0].seq_len, 1000)
  assert_eq(nuc[0].hits[0].hsps.length(), 2)
  assert_eq(nuc[0].hits[0].hsps[0].match_num, 40)
  assert_eq(nuc[0].hits[0].hsps[0].mismatch_num, 2)
  assert_eq(nuc[0].hits[0].hsps[0].match_rep_num, 1)
  assert_eq(nuc[0].hits[0].hsps[0].n_num, 0)
  assert_eq(nuc[0].hits[0].hsps[0].query_gapopen_num, 1)
  assert_eq(nuc[0].hits[0].hsps[0].query_gap_num, 5)
  assert_eq(nuc[0].hits[0].hsps[0].hit_gapopen_num, 1)
  assert_eq(nuc[0].hits[0].hsps[0].hit_gap_num, 8)
  assert_eq(nuc[0].hits[0].hsps[0].ident_num, 41)
  assert_eq(nuc[0].hits[0].hsps[0].gapopen_num, 2)
  assert_eq(nuc[0].hits[0].hsps[0].gap_num, 13)
  assert_eq(nuc[0].hits[0].hsps[0].query_is_protein, false)
  assert_eq(nuc[0].hits[0].hsps[0].has_hit_strand, false)
  assert_eq(nuc[0].hits[0].hsps[0].score, 36)
  assert_true(blat_close(nuc[0].hits[0].hsps[0].ident_pct, 93.02325581395348))
  assert_eq(nuc[0].hits[0].hsps[0].blocks.length(), 2)
  assert_eq(nuc[0].hits[0].hsps[0].blocks[0].query_start, 10)
  assert_eq(nuc[0].hits[0].hsps[0].blocks[0].query_end, 30)
  assert_eq(nuc[0].hits[0].hsps[0].blocks[0].hit_start, 100)
  assert_eq(nuc[0].hits[0].hsps[0].blocks[0].hit_end, 120)
  assert_eq(nuc[0].hits[0].hsps[0].blocks[0].query_strand, 1)
