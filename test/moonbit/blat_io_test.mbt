test "blat-psl parse: single-char strand and protein query" {
  let mix = @src.blat_psl_parse(blat_mix_text) catch {
    _ => abort("valid PSL should parse")
  }
  assert_eq(mix.length(), 2)
  assert_eq(mix[0].id, "q2")
  assert_eq(mix[0].seq_len, 80)
  assert_eq(mix[0].program, "blat")
  assert_eq(mix[0].hits.length(), 1)
  assert_eq(mix[0].hits[0].id, "chr3")
  assert_eq(mix[0].hits[0].seq_len, 400)
  assert_eq(mix[0].hits[0].hsps.length(), 1)
  assert_eq(mix[0].hits[0].hsps[0].match_num, 5)
  assert_eq(mix[0].hits[0].hsps[0].mismatch_num, 0)
  assert_eq(mix[0].hits[0].hsps[0].match_rep_num, 0)
  assert_eq(mix[0].hits[0].hsps[0].n_num, 0)
  assert_eq(mix[0].hits[0].hsps[0].query_gapopen_num, 0)
  assert_eq(mix[0].hits[0].hsps[0].query_gap_num, 0)
  assert_eq(mix[0].hits[0].hsps[0].hit_gapopen_num, 0)
  assert_eq(mix[0].hits[0].hsps[0].hit_gap_num, 0)
  assert_eq(mix[0].hits[0].hsps[0].ident_num, 5)
  assert_eq(mix[0].hits[0].hsps[0].gapopen_num, 0)
  assert_eq(mix[0].hits[0].hsps[0].gap_num, 0)
  assert_eq(mix[0].hits[0].hsps[0].query_is_protein, false)
  assert_eq(mix[0].hits[0].hsps[0].has_hit_strand, false)
  assert_eq(mix[0].hits[0].hsps[0].score, 5)
  assert_true(blat_close(mix[0].hits[0].hsps[0].ident_pct, 100.0))
  assert_eq(mix[0].hits[0].hsps[0].blocks.length(), 1)
  assert_eq(mix[0].hits[0].hsps[0].blocks[0].query_start, 16)
  assert_eq(mix[0].hits[0].hsps[0].blocks[0].query_end, 21)
  assert_eq(mix[0].hits[0].hsps[0].blocks[0].hit_start, 0)
  assert_eq(mix[0].hits[0].hsps[0].blocks[0].hit_end, 5)
  assert_eq(mix[0].hits[0].hsps[0].blocks[0].query_strand, -1)
  assert_eq(mix[0].hits[0].hsps[0].blocks[0].hit_strand, 1)
  assert_eq(mix[0].hits[0].hsps[0].blocks[0].query_seq, "")
  assert_eq(mix[0].hits[0].hsps[0].blocks[0].hit_seq, "")
  assert_eq(mix[1].id, "q3")
  assert_eq(mix[1].seq_len, 40)
  assert_eq(mix[1].program, "blat")
  assert_eq(mix[1].hits.length(), 1)
  assert_eq(mix[1].hits[0].id, "chrP")
  assert_eq(mix[1].hits[0].seq_len, 300)
  assert_eq(mix[1].hits[0].hsps.length(), 1)
  assert_eq(mix[1].hits[0].hsps[0].match_num, 28)
  assert_eq(mix[1].hits[0].hsps[0].mismatch_num, 1)
  assert_eq(mix[1].hits[0].hsps[0].match_rep_num, 1)
  assert_eq(mix[1].hits[0].hsps[0].n_num, 0)
  assert_eq(mix[1].hits[0].hsps[0].query_gapopen_num, 1)
  assert_eq(mix[1].hits[0].hsps[0].query_gap_num, 0)
  assert_eq(mix[1].hits[0].hsps[0].hit_gapopen_num, 1)
  assert_eq(mix[1].hits[0].hsps[0].hit_gap_num, 0)
  assert_eq(mix[1].hits[0].hsps[0].ident_num, 29)
  assert_eq(mix[1].hits[0].hsps[0].gapopen_num, 2)
  assert_eq(mix[1].hits[0].hsps[0].gap_num, 0)
  assert_eq(mix[1].hits[0].hsps[0].query_is_protein, true)
  assert_eq(mix[1].hits[0].hsps[0].has_hit_strand, true)
  assert_eq(mix[1].hits[0].hsps[0].score, 79)
  assert_true(blat_close(mix[1].hits[0].hsps[0].ident_pct, 95.55555555555556))
  assert_eq(mix[1].hits[0].hsps[0].blocks.length(), 2)
  assert_eq(mix[1].hits[0].hsps[0].blocks[0].query_start, 5)
  assert_eq(mix[1].hits[0].hsps[0].blocks[0].query_end, 15)
  assert_eq(mix[1].hits[0].hsps[0].blocks[0].hit_start, 30)
  assert_eq(mix[1].hits[0].hsps[0].blocks[0].hit_end, 60)
  assert_eq(mix[1].hits[0].hsps[0].blocks[0].query_strand, 0)
  assert_eq(mix[1].hits[0].hsps[0].blocks[0].hit_strand, 1)
  assert_eq(mix[1].hits[0].hsps[0].blocks[0].query_seq, "")
  assert_eq(mix[1].hits[0].hsps[0].blocks[0].hit_seq, "")
  assert_eq(mix[1].hits[0].hsps[0].blocks[1].query_start, 15)
  assert_eq(mix[1].hits[0].hsps[0].blocks[1].query_end, 35)
  assert_eq(mix[1].hits[0].hsps[0].blocks[1].hit_start, 90)
  assert_eq(mix[1].hits[0].hsps[0].blocks[1].hit_end, 150)
  assert_eq(mix[1].hits[0].hsps[0].blocks[1].query_strand, 0)
  assert_eq(mix[1].hits[0].hsps[0].blocks[1].hit_strand, 1)
  assert_eq(mix[1].hits[0].hsps[0].blocks[1].query_seq, "")
  assert_eq(mix[1].hits[0].hsps[0].blocks[1].hit_seq, "")
  println("mix structure ok")
}

test "blat-pslx parse: block sequences and minus/plus strands" {
  let pslx_res = @src.blat_psl_parse(blat_pslx_text, pslx=true) catch {
    _ => abort("valid PSLX should parse")
  }
  assert_eq(pslx_res.length(), 1)
  assert_eq(pslx_res[0].id, "qx")
  assert_eq(pslx_res[0].seq_len, 60)
  assert_eq(pslx_res[0].program, "blat")
  assert_eq(pslx_res[0].hits.length(), 2)
  assert_eq(pslx_res[0].hits[0].id, "chrA")
  assert_eq(pslx_res[0].hits[0].seq_len, 900)
  assert_eq(pslx_res[0].hits[0].hsps.length(), 1)
  assert_eq(pslx_res[0].hits[0].hsps[0].match_num, 18)
  assert_eq(pslx_res[0].hits[0].hsps[0].mismatch_num, 1)
  assert_eq(pslx_res[0].hits[0].hsps[0].match_rep_num, 1)
  assert_eq(pslx_res[0].hits[0].hsps[0].n_num, 0)
  assert_eq(pslx_res[0].hits[0].hsps[0].query_gapopen_num, 1)
  assert_eq(pslx_res[0].hits[0].hsps[0].query_gap_num, 4)
  assert_eq(pslx_res[0].hits[0].hsps[0].hit_gapopen_num, 0)
  assert_eq(pslx_res[0].hits[0].hsps[0].hit_gap_num, 0)
  assert_eq(pslx_res[0].hits[0].hsps[0].ident_num, 19)
  assert_eq(pslx_res[0].hits[0].hsps[0].gapopen_num, 1)
  assert_eq(pslx_res[0].hits[0].hsps[0].gap_num, 4)
  assert_eq(pslx_res[0].hits[0].hsps[0].query_is_protein, false)
  assert_eq(pslx_res[0].hits[0].hsps[0].has_hit_strand, false)
  assert_eq(pslx_res[0].hits[0].hsps[0].score, 16)
  assert_true(blat_close(pslx_res[0].hits[0].hsps[0].ident_pct, 90.0))
  assert_eq(pslx_res[0].hits[0].hsps[0].blocks.length(), 2)
  assert_eq(pslx_res[0].hits[0].hsps[0].blocks[0].query_start, 5)
  assert_eq(pslx_res[0].hits[0].hsps[0].blocks[0].query_end, 15)
