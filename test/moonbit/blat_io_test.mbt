test "blat-pslx round trip: sequences survive writing" {
  let pslx_res = @src.blat_psl_parse(blat_pslx_text, pslx=true) catch {
    _ => abort("valid PSLX should parse")
  }
  let written_x = @src.blat_psl_write(pslx_res, pslx=true) catch {
    _ => abort("write should not fail")
  }
  let rt_pslx = @src.blat_psl_parse(written_x, pslx=true) catch {
    _ => abort("round trip should parse")
  }
  assert_eq(rt_pslx.length(), 1)
  assert_eq(rt_pslx[0].id, "qx")
  assert_eq(rt_pslx[0].seq_len, 60)
  assert_eq(rt_pslx[0].program, "blat")
  assert_eq(rt_pslx[0].hits.length(), 2)
  assert_eq(rt_pslx[0].hits[0].id, "chrA")
  assert_eq(rt_pslx[0].hits[0].seq_len, 900)
  assert_eq(rt_pslx[0].hits[0].hsps.length(), 1)
  assert_eq(rt_pslx[0].hits[0].hsps[0].match_num, 18)
  assert_eq(rt_pslx[0].hits[0].hsps[0].mismatch_num, 1)
  assert_eq(rt_pslx[0].hits[0].hsps[0].match_rep_num, 1)
  assert_eq(rt_pslx[0].hits[0].hsps[0].n_num, 0)
  assert_eq(rt_pslx[0].hits[0].hsps[0].query_gapopen_num, 1)
  assert_eq(rt_pslx[0].hits[0].hsps[0].query_gap_num, 4)
  assert_eq(rt_pslx[0].hits[0].hsps[0].hit_gapopen_num, 0)
  assert_eq(rt_pslx[0].hits[0].hsps[0].hit_gap_num, 0)
  assert_eq(rt_pslx[0].hits[0].hsps[0].ident_num, 19)
  assert_eq(rt_pslx[0].hits[0].hsps[0].gapopen_num, 1)
  assert_eq(rt_pslx[0].hits[0].hsps[0].gap_num, 4)
  assert_eq(rt_pslx[0].hits[0].hsps[0].query_is_protein, false)
  assert_eq(rt_pslx[0].hits[0].hsps[0].has_hit_strand, false)
  assert_eq(rt_pslx[0].hits[0].hsps[0].score, 16)
  assert_true(blat_close(rt_pslx[0].hits[0].hsps[0].ident_pct, 90.0))
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks.length(), 2)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[0].query_start, 5)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[0].query_end, 15)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[0].hit_start, 50)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[0].hit_end, 60)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[0].query_strand, 1)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[0].hit_strand, 1)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[0].query_seq, "AAAAATTTTT")
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[0].hit_seq, "AAAAATTT-T")
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[1].query_start, 19)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[1].query_end, 29)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[1].hit_start, 64)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[1].hit_end, 74)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[1].query_strand, 1)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[1].hit_strand, 1)
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[1].query_seq, "CCCCCGGGGG")
  assert_eq(rt_pslx[0].hits[0].hsps[0].blocks[1].hit_seq, "CCCCCGGGGG")
  assert_eq(rt_pslx[0].hits[1].id, "chrB")
  assert_eq(rt_pslx[0].hits[1].seq_len, 700)
  assert_eq(rt_pslx[0].hits[1].hsps.length(), 1)
  assert_eq(rt_pslx[0].hits[1].hsps[0].match_num, 16)
  assert_eq(rt_pslx[0].hits[1].hsps[0].mismatch_num, 2)
  assert_eq(rt_pslx[0].hits[1].hsps[0].match_rep_num, 0)
  assert_eq(rt_pslx[0].hits[1].hsps[0].n_num, 0)
  assert_eq(rt_pslx[0].hits[1].hsps[0].query_gapopen_num, 0)
  assert_eq(rt_pslx[0].hits[1].hsps[0].query_gap_num, 0)
  assert_eq(rt_pslx[0].hits[1].hsps[0].hit_gapopen_num, 1)
  assert_eq(rt_pslx[0].hits[1].hsps[0].hit_gap_num, 6)
  assert_eq(rt_pslx[0].hits[1].hsps[0].ident_num, 16)
  assert_eq(rt_pslx[0].hits[1].hsps[0].gapopen_num, 1)
  assert_eq(rt_pslx[0].hits[1].hsps[0].gap_num, 6)
  assert_eq(rt_pslx[0].hits[1].hsps[0].query_is_protein, false)
  assert_eq(rt_pslx[0].hits[1].hsps[0].has_hit_strand, true)
  assert_eq(rt_pslx[0].hits[1].hsps[0].score, 13)
  assert_true(blat_close(rt_pslx[0].hits[1].hsps[0].ident_pct, 88.88888888888889))
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks.length(), 2)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[0].query_start, 50)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[0].query_end, 58)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[0].hit_start, 100)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[0].hit_end, 108)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[0].query_strand, -1)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[0].hit_strand, 1)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[0].query_seq, "ACGTACGT")
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[0].hit_seq, "AC-TACGT")
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[1].query_start, 38)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[1].query_end, 46)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[1].hit_start, 112)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[1].hit_end, 120)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[1].query_strand, -1)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[1].hit_strand, 1)
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[1].query_seq, "TGCATGCA")
  assert_eq(rt_pslx[0].hits[1].hsps[0].blocks[1].hit_seq, "TGC-TGCA")
  println("roundtrip pslx structure ok")
}

test "BlatQueryResult.to_search_io converts to the generic SearchIO model" {
  let nuc = @src.blat_psl_parse(blat_nuc_text) catch {
    _ => abort("valid PSL should parse")
  }
  let generic = nuc[0].to_search_io()
  assert_eq(generic.id, "q1")
  assert_eq(generic.seq_length, 100)
  assert_eq(generic.hits.length(), 2)
  assert_eq(generic.hits[0].id, "chr1")
  assert_eq(generic.hits[0].hsps.length(), 2)
  // 0-based half-open [10, 30) becomes 1-based inclusive start 11
  assert_eq(generic.hits[0].hsps[0].query_start, 11)
  assert_eq(generic.hits[0].hsps[0].query_end, 45)
  assert_eq(generic.hits[0].hsps[0].hit_start, 101)
  assert_eq(generic.hits[0].hsps[0].hit_end, 138)
  assert_true(blat_close(generic.hits[0].hsps[0].bitscore, 36.0))
  assert_true(blat_close(generic.hits[0].hsps[0].identity, 93.02325581395348))
  assert_true(blat_close(generic.hits[0].hsps[0].evalue, 0.0))
  let generic_mix = @src.blat_psl_parse(blat_mix_text) catch {
    _ => abort("valid PSL should parse")
  }
  assert_eq(generic_mix[1].to_search_io().hits[0].hsps[0].query_start, 6)
  assert_eq(generic_mix[1].to_search_io().hits[0].hsps[0].query_end, 35)
  assert_true(blat_close(generic_mix[1].to_search_io().hits[0].hsps[0].bitscore, 79.0))
  let generic_x = @src.blat_psl_parse(blat_pslx_text, pslx=true) catch {
    _ => abort("valid PSLX should parse")
  }
  assert_eq(generic_x[0].to_search_io().hits[0].hsps[0].query_seq, "AAAAATTTTTCCCCCGGGGG")
  assert_eq(generic_x[0].to_search_io().hits[0].hsps[0].hit_seq, "AAAAATTT-TCCCCCGGGGG")
}

test "blat-psl write: PSLX data can be written as plain PSL" {
  let pslx_res = @src.blat_psl_parse(blat_pslx_text, pslx=true) catch {
    _ => abort("valid PSLX should parse")
  }
  let written_plain = @src.blat_psl_write(pslx_res) catch {
    _ => abort("write should not fail")
  }
  let reparsed = @src.blat_psl_parse(written_plain) catch {
    _ => abort("plain PSL should parse")
  }
  assert_eq(reparsed.length(), 1)
  assert_eq(reparsed[0].hits.length(), 2)
  assert_eq(reparsed[0].hits[0].hsps[0].blocks[0].query_seq, "")
  // writing nucleotide HSPs as PSLX (empty sequences) round trips too
  let nuc = @src.blat_psl_parse(blat_nuc_text) catch {
    _ => abort("valid PSL should parse")
  }
  let nuc_as_pslx = @src.blat_psl_write(nuc, pslx=true) catch {
    _ => abort("write should not fail")
  }
  let rt = @src.blat_psl_parse(nuc_as_pslx, pslx=true) catch {
    _ => abort("PSLX should parse")
  }
  assert_eq(rt.length(), 2)
  assert_eq(rt[0].hits[0].hsps[0].blocks[0].query_seq, "")
}
