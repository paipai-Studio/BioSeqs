///|
/// Biopython TRANS matrix (4 letters).
fn bio_matrix_trans() -> SubsMatrix {
  let alpha : Array[String] = ["A", "T", "C", "G"]
  let values : Array[Double] = [
    5.0, 0.0, 0.0, 4.0, 0.0, 5.0, 4.0, 0.0,
    0.0, 4.0, 5.0, 0.0, 4.0, 0.0, 0.0, 5.0
  ]
  bio_flat_matrix("TRANS", alpha, values)
}

///|
/// (canonical registry name, constructor) for all 30 Biopython matrices.
let bio_matrix_table : Array[(String, () -> SubsMatrix)] = [
  ("BENNER22", bio_matrix_benner22),
  ("BENNER6", bio_matrix_benner6),
  ("BENNER74", bio_matrix_benner74),
  ("BLASTN", bio_matrix_blastn),
  ("BLASTP", bio_matrix_blastp),
  ("BLOSUM45", bio_matrix_blosum45),
  ("BLOSUM50", bio_matrix_blosum50),
  ("BLOSUM62", bio_matrix_blosum62),
  ("BLOSUM80", bio_matrix_blosum80),
  ("BLOSUM90", bio_matrix_blosum90),
  ("DAYHOFF", bio_matrix_dayhoff),
  ("FENG", bio_matrix_feng),
  ("GENETIC", bio_matrix_genetic),
  ("GONNET1992", bio_matrix_gonnet1992),
  ("HOXD70", bio_matrix_hoxd70),
  ("JOHNSON", bio_matrix_johnson),
  ("JONES", bio_matrix_jones),
  ("LEVIN", bio_matrix_levin),
  ("MCLACHLAN", bio_matrix_mclachlan),
  ("MDM78", bio_matrix_mdm78),
  ("MEGABLAST", bio_matrix_megablast),
  ("NUC.4.4", bio_matrix_nuc_4_4),
  ("PAM250", bio_matrix_pam250),
  ("PAM30", bio_matrix_pam30),
  ("PAM70", bio_matrix_pam70),
  ("RAO", bio_matrix_rao),
  ("RISLER", bio_matrix_risler),
  ("SCHNEIDER", bio_matrix_schneider),
  ("STR", bio_matrix_str),
  ("TRANS", bio_matrix_trans),
]

///|
/// Cached DistanceCalculator model name lists (Biopython classification).
let bio_dna_models : Ref[Array[String]] = Ref([])
let bio_protein_models : Ref[Array[String]] = Ref([])

///|
/// Register all 30 Biopython matrices under their canonical names and
/// classify them into the DistanceCalculator dna/protein model lists.
fn register_biopython_matrices() -> Unit {
  let protein_letters = "ABCDEFGHIKLMNPQRSTVWXYZ"
  let dna : Array[String] = []
  let protein : Array[String] = []
  for entry in bio_matrix_table {
    let canonical = entry.0
    let make = entry.1
    let m = make()
    register_matrix(canonical, m)
    let model_name = if canonical == "NUC.4.4" {
      "blastn"
    } else {
      to_lowercase(canonical)
    }
    let mut is_protein = true
    for k in 0..<protein_letters.length() {
      let ch = codeunit_to_string(protein_letters.unsafe_get(k))
      if !m.has_letter(ch) {
        is_protein = false
        break
      }
    }
    if is_protein {
      protein.push(model_name)
    } else {
      dna.push(model_name)
    }
  }
  bio_dna_models.val = dna
  bio_protein_models.val = protein
}

///|
/// DNA distance model names (DistanceCalculator.dna_models equivalent).
pub fn bio_dna_model_names() -> Array[String] {
  bio_dna_models.val.copy()
}

///|
/// Protein distance model names (DistanceCalculator.protein_models equivalent).
pub fn bio_protein_model_names() -> Array[String] {
  bio_protein_models.val.copy()
}

///|
/// All distance model names: ["identity"] + dna models + protein models.
pub fn bio_distance_model_names() -> Array[String] {
  let models : Array[String] = ["identity"]
  for name in bio_dna_models.val {
    models.push(name)
  }
  for name in bio_protein_models.val {
    models.push(name)
  }
  models
}
