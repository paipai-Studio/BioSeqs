///|
/// Biopython 1.88 built-in substitution matrices (Bio.Align.substitution_matrices).
///
/// This file is auto-generated by /tmp/gen_subs_matrices.py from the local
/// Biopython 1.88 data files; do not edit scores by hand.
/// It provides the 30 canonical matrices with their original alphabets
/// (including the 24-letter BLOSUM/PAM alphabets with B/Z/X/*, the 15-letter
/// IUPAC nucleotide alphabet, the 27-letter BLASTP alphabet and the 64-codon
/// SCHNEIDER alphabet).

///|
/// Build a SubsMatrix from a flat row-major score table.
fn bio_flat_matrix(
  name : String,
  alpha : Array[String],
  values : Array[Double],
) -> SubsMatrix {
  let n = alpha.length()
  let data : Array[Array[Double]] = []
  for i in 0..<n {
    let row : Array[Double] = []
    for j in 0..<n {
      row.push(values[i * n + j])
    }
    data.push(row)
  }
  subs_matrix(name, alpha, { rows: alpha, cols: alpha, data } )
}

