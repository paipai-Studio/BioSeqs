///|
pub let restriction_db : Array[
  (
    String,
    String,
    Int,
    Int?,
    Int?,
    Int?,
    Int?,
    Int?,
    String,
    Double,
    String,
    Bool,
    Int,
    String,
  ),
] = {
  let all : Array[
    (
      String,
      String,
      Int,
      Int?,
      Int?,
      Int?,
      Int?,
      Int?,
      String,
      Double,
      String,
      Bool,
      Int,
      String,
    ),
  ] = []
  for row in restriction_db_chunk0 {
    all.push(row)
  }
  for row in restriction_db_chunk1 {
    all.push(row)
  }
  for row in restriction_db_chunk2 {
    all.push(row)
  }
  for row in restriction_db_chunk3 {
    all.push(row)
  }
  all
}

///|
/// Number of restriction enzymes in the database (1088).
pub let restriction_db_size : Int = 1088
