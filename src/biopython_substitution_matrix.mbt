  let m = [
    [
      6, -7, -4, -3, -6, -3, -2, -2, -7, -5, -6, -7, -5, -7, -2, 1, 0, -11, -7, -2,
    ],
    [
      -7, 10, -6, -10, -10, -1, -2, -10, -1, -6, -8, 3, -4, -10, -6, -4, -5, -4,
      -6, -8,
    ],
    [
      -4, -6, 10, 1, -10, -2, -1, -2, 2, -7, -8, -1, -8, -10, -7, 0, -1, -10, -4,
      -8,
    ],
    [
      -3, -10, 1, 10, -10, -1, 2, -2, -1, -8, -10, -2, -8, -10, -6, -1, -3, -10,
      -8, -8,
    ],
    [
      -6, -10, -10, -10, 16, -10, -10, -10, -10, -6, -9, -10, -9, -7, -10, -3, -6,
      -10, -10, -6,
    ],
    [
      -3, -1, -2, -1, -10, 9, 2, -7, 0, -7, -6, 0, -3, -10, -2, -2, -3, -10, -8,
      -6,
    ],
    [
      -2, -2, -1, 2, -10, 2, 8, -5, -1, -8, -8, -1, -6, -10, -3, -1, -3, -10, -7,
      -7,
    ],
    [
      -2, -10, -2, -2, -10, -7, -5, 10, -10, -10, -10, -7, -8, -10, -8, -1, -5, -10,
      -10, -5,
    ],
    [
      -7, -1, 2, -1, -10, 0, -1, -10, 12, -8, -7, -2, -8, -3, -7, -2, -5, -3, 2,
      -8,
    ],
    [
      -5, -6, -7, -8, -6, -7, -8, -10, -8, 8, 2, -6, 1, -1, -8, -6, -1, -7, -5, 4,
    ],
    [
      -6, -8, -8, -10, -9, -6, -8, -10, -7, 2, 7, -7, 4, -1, -7, -7, -5, -5, -4,
      2,
    ],
    [
      -7, 3, -1, -2, -10, 0, -1, -7, -2, -6, -7, 8, -3, -10, -5, -3, -4, -8, -7,
      -8,
    ],
    [
      -5, -4, -8, -8, -9, -3, -6, -8, -8, 1, 4, -3, 12, -1, -6, -5, -3, -6, -5, 1,
    ],
    [
      -7, -10, -10, -10, -7, -10, -10, -10, -3, -1, -1, -10, -1, 12, -10, -5, -7,
      1, 5, -3,
    ],
    [
      -2, -6, -7, -6, -10, -2, -3, -8, -7, -8, -7, -5, -6, -10, 12, -2, -3, -10,
      -10, -6,
    ],
    [1, -4, 0, -1, -3, -2, -1, -1, -2, -6, -7, -3, -5, -5, -2, 5, 2, -6, -4, -3],
    [
      0, -5, -1, -3, -6, -3, -3, -5, -5, -1, -5, -4, -3, -7, -3, 2, 6, -10, -4, 0,
