  { name: "PAM30", alphabet: aa, matrix: m, }
}

///|
/// Look up a score in the substitution matrix.
pub fn BiopythonSubstMatrix::score(
  self : BiopythonSubstMatrix,
  aa1 : String,
  aa2 : String,
) -> Int32 {
  let mut idx1 = -1
  let mut idx2 = -1
  for i = 0; i < self.alphabet.length(); i = i + 1 {
    if self.alphabet[i] == aa1 {
      idx1 = i
    }
    if self.alphabet[i] == aa2 {
      idx2 = i
    }
  }
  if idx1 < 0 || idx2 < 0 {
    return -4 // default penalty for unknown
  }
  self.matrix[idx1][idx2]
}

///|
/// Get the alphabet of the matrix.
pub fn BiopythonSubstMatrix::alphabet_size(
  self : BiopythonSubstMatrix,
) -> Int32 {
  self.alphabet.length()
}

///|
/// Compute average score between two sequences using a substitution matrix.
pub fn biopython_substitution_score(
  seq1 : String,
  seq2 : String,
  matrix : BiopythonSubstMatrix,
) -> Int32 {
  let n = if seq1.length() < seq2.length() {
    seq1.length()
  } else {
    seq2.length()
  }
  let mut total = 0
  for i = 0; i < n; i = i + 1 {
    let aa1 = seq1[i:i + 1].to_owned()
    let aa2 = seq2[i:i + 1].to_owned()
    total = total + matrix.score(aa1, aa2)
  }
  total
}
