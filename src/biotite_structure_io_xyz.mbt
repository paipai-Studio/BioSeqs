///|
/// biotite_structure_io_xyz.mbt — XYZ coordinate reader/writer.

///|
/// Parse an XYZ file into an AtomArray.
///
/// The first line is the atom count, the second a comment, and each atom
/// line is `element x y z`.
pub fn biotite_xyz_parse(text : String) -> AtomArray {
  let lines = text.split("\n").to_array()
  let atoms : Array[Atom] = []
  if lines.length() < 2 {
    return AtomArray::from_atoms(atoms)
  }
  let n = parse_int(lines[0].trim().to_owned())
  for k in 0..<n {
    let idx = 2 + k
    if idx >= lines.length() {
      break
    }
    let fields = lines[idx].trim().split(" ").to_array()
    let parts : Array[String] = []
    for f in fields {
      if f.length() > 0 {
        parts.push(f.to_owned())
      }
    }
    if parts.length() < 4 {
      continue
    }
    let x = match parse_double(parts[1]) {
      Some(v) => v
      None => 0.0
    }
    let y = match parse_double(parts[2]) {
      Some(v) => v
      None => 0.0
    }
    let z = match parse_double(parts[3]) {
      Some(v) => v
      None => 0.0
    }
    atoms.push(
      Atom::new(
        name=parts[0],
        coord=Vector3::new(x, y, z),
        resname="UNK",
        element=parts[0],
      ),
    )
  }
  AtomArray::from_atoms(atoms)
}

///|
/// Write an AtomArray as XYZ.
pub fn biotite_xyz_write(arr : AtomArray) -> String {
  let sb = StringBuilder()
  let _ = sb.write(arr.len().to_string() + "\n")
  let _ = sb.write("generated by BioSeqs\n")
  for i in 0..<arr.len() {
    let c = arr.get_coord(i)
    let element = if arr.elements[i].length() > 0 {
      arr.elements[i]
    } else {
      "X"
    }
    let _ = sb.write(
      element +
      " " +
      c.x.to_string() +
      " " +
      c.y.to_string() +
      " " +
      c.z.to_string() +
      "\n",
    )
  }
  sb.to_string()
}
