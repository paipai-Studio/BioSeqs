///|
/// GRO format reader/writer for GROMACS trajectory frames.
/// Ported from biotite.structure.io.gro.
///
/// GRO format stores coordinates in nm (not Å).

///|
/// A single GRO frame: atoms with coordinates and optional velocities.
pub struct GroFrame {
  atoms : Array[GroAtom]
  // Box vectors (3×3), row-major; empty if no box
  box : Array[Array[Double]]
}

///|
/// A single atom in a GRO frame.
pub struct GroAtom {
  res_id : Int
  res_name : String
  atom_name : String
  atom_id : Int
  x : Double // nm
  y : Double // nm
  z : Double // nm
}

///|
/// Parse a GRO file string into a GroFrame.
pub fn gro_parse(content : String) -> GroFrame {
  let lines = content.split("\n").to_array()
  // Line 0: title
  // Line 1: number of atoms
  let n_atoms = pdb_parse_int_fast(lines[1].trim())
  let atoms : Array[GroAtom] = Array(capacity=n_atoms)
  for i = 0; i < n_atoms; i = i + 1 {
    let line = lines[2 + i]
    atoms.push(parse_gro_atom_line(line))
  }
  // Box line (optional)
  let box : Array[Array[Double]] = Array(capacity=0)
  let box_line_idx = 2 + n_atoms
  if box_line_idx < lines.length() {
    let box_line = lines[box_line_idx].trim()
    if box_line.length() > 0 {
      let parts = box_line.split(" ")
      let nums : Array[Double] = Array(capacity=9)
      for p in parts {
        let t = p.trim()
        if t.length() > 0 {
          nums.push(pdb_parse_double_fast(t))
        }
      }
      if nums.length() >= 9 {
        box.push([nums[0], nums[1], nums[2]])
        box.push([nums[3], nums[4], nums[5]])
        box.push([nums[6], nums[7], nums[8]])
      } else if nums.length() >= 3 {
        // Diagonal box
        box.push([nums[0], 0.0, 0.0])
        box.push([0.0, nums[1], 0.0])
        box.push([0.0, 0.0, nums[2]])
      }
    }
  }
  GroFrame::{ atoms, box }
}

///|
/// Safe substring: clamp end to line length.
fn gro_safe_slice(line : StringView, start : Int, end : Int) -> StringView {
  let len = line.length()
  let s = if start < len { start } else { len }
  let e = if end < len { end } else { len }
  if s < e {
    line[s:e]
  } else {
    ""
  }
}

///|
/// Parse a single GRO atom line.
/// Fixed-column format:
///   1-5: res id, 6-10: res name, 11-15: atom name,
///   16-20: atom id, 21-28: x, 29-36: y, 37-44: z
/// Falls back to space-delimited if columns don't make sense.
fn parse_gro_atom_line(line : StringView) -> GroAtom {
  let len = line.length()
  // Try fixed-column format if we have at least through atom_id (20 chars)
  if len >= 20 {
    let res_id = pdb_parse_int_fast(gro_safe_slice(line, 0, 5).trim())
    let res_name = gro_safe_slice(line, 5, 10).trim().to_string()
    let atom_name = gro_safe_slice(line, 10, 15).trim().to_string()
    let atom_id = pdb_parse_int_fast(gro_safe_slice(line, 15, 20).trim())
    // Parse coordinates from whatever remains
    let x = if len > 20 {
      pdb_parse_double_fast(gro_safe_slice(line, 20, 28).trim())
    } else {
      0.0
    }
    let y = if len > 28 {
      pdb_parse_double_fast(gro_safe_slice(line, 28, 36).trim())
    } else {
      0.0
    }
    let z = if len > 36 {
      pdb_parse_double_fast(gro_safe_slice(line, 36, 44).trim())
    } else {
      0.0
    }
    // Sanity check: res_name should be alphabetic, not numeric
    if res_name.length() > 0 && res_id > 0 {
      return GroAtom::{ res_id, res_name, atom_name, atom_id, x, y, z }
    }
  }
  // Fallback: space-delimited
  let parts = line.split(" ")
  let nums : Array[StringView] = Array(capacity=0)
  for p in parts {
    let t = p.trim()
    if t.length() > 0 {
      nums.push(t)
    }
  }
  // res_id res_name atom_name atom_id x y z
  GroAtom::{
    res_id: pdb_parse_int_fast(nums[0]),
    res_name: nums[1].to_string(),
    atom_name: nums[2].to_string(),
    atom_id: pdb_parse_int_fast(nums[3]),
    x: pdb_parse_double_fast(nums[4]),
    y: pdb_parse_double_fast(nums[5]),
    z: pdb_parse_double_fast(nums[6]),
  }
}

///|
/// Write a GroFrame to GRO format string.
pub fn gro_write(frame : GroFrame) -> String {
  let sb = StringBuilder()
  // Title
  sb.write_string("Generated by BioSeqs\n")
  // Number of atoms
  sb.write_string(frame.atoms.length().to_string())
  sb.write_char('\n')
  // Atom lines
  for i = 0; i < frame.atoms.length(); i = i + 1 {
    let a = frame.atoms[i]
    sb.write_string(format_gro_atom_line(a, i + 1))
    sb.write_char('\n')
  }
  // Box
  if frame.box.length() >= 3 {
    let b = frame.box
    sb.write_string(
      format_gro_num(b[0][0]) +
      " " +
      format_gro_num(b[0][1]) +
      " " +
      format_gro_num(b[0][2]) +
      " " +
      format_gro_num(b[1][0]) +
      " " +
      format_gro_num(b[1][1]) +
      " " +
      format_gro_num(b[1][2]) +
      " " +
      format_gro_num(b[2][0]) +
      " " +
      format_gro_num(b[2][1]) +
      " " +
      format_gro_num(b[2][2]),
    )
    sb.write_char('\n')
  } else {
    sb.write_string("0.00000 0.00000 0.00000\n")
  }
  sb.to_string()
}

///|
/// Format a GRO atom line (fixed-column).
fn format_gro_atom_line(a : GroAtom, serial : Int) -> String {
  let sb = StringBuilder()
  // res_id (5 chars, right-aligned)
  sb.write_string(format_int_right(a.res_id, 5))
  // res_name (5 chars, left-aligned)
  sb.write_string(format_str_left(a.res_name, 5))
  // atom_name (5 chars, left-aligned)
  sb.write_string(format_str_left(a.atom_name, 5))
  // atom_id (5 chars, right-aligned)
  sb.write_string(format_int_right(a.atom_id, 5))
  // x, y, z (8 chars each, 3 decimal places)
  sb.write_string(format_gro_num(a.x))
  sb.write_string(format_gro_num(a.y))
  sb.write_string(format_gro_num(a.z))
  sb.to_string()
}

///|
/// Format a number for GRO: 8 chars wide, 3 decimal places.
fn format_gro_num(x : Double) -> String {
  let s = x.to_string()
  // Find decimal point
  let dot_opt = s.find(".")
  let dot = match dot_opt { Some(d) => d; None => -1 }
  if dot < 0 {
    // No decimal point
    return s + ".000"
  }
  let int_part = s.substring(start=0, end=dot)
  let frac_part = s.substring(start=dot + 1, end=s.length())
  let frac3 = if frac_part.length() >= 3 {
    frac_part.substring(start=0, end=3)
  } else {
    frac_part + "000".substring(start=0, end=3 - frac_part.length())
  }
  let num_str = int_part + "." + frac3
  // Pad to 8 chars
  if num_str.length() >= 8 {
    return num_str
  }
  "        ".substring(start=0, end=8 - num_str.length()) + num_str
}

///|
/// Format integer right-aligned in n chars.
fn format_int_right(n : Int, width : Int) -> String {
  let s = n.to_string()
  if s.length() >= width {
    return s
  }
  "     ".substring(start=0, end=width - s.length()) + s
}

///|
/// Format string left-aligned in n chars.
fn format_str_left(s : String, width : Int) -> String {
  if s.length() >= width {
    return s
  }
  s + "     ".substring(start=0, end=width - s.length())
}

///|
/// Convert GRO coordinates from nm to Å.
pub fn gro_nm_to_angstrom(coords : Array[Double]) -> Array[Double] {
  let result : Array[Double] = Array(capacity=coords.length())
  for i = 0; i < coords.length(); i = i + 1 {
    result.push(coords[i] * 10.0)
  }
  result
}

///|
/// Convert Å coordinates to GRO nm.
pub fn gro_angstrom_to_nm(coords : Array[Double]) -> Array[Double] {
  let result : Array[Double] = Array(capacity=coords.length())
  for i = 0; i < coords.length(); i = i + 1 {
    result.push(coords[i] / 10.0)
  }
  result
}
