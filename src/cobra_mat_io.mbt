/// cobra_mat_io.mbt — MATLAB .mat format read/write (COBRApy io.mat)
/// Simplified MAT format support for COBRA Toolbox compatibility.
/// Writes a struct with S, lb, ub, c, rxns, mets fields.

///|
/// Write FBA model to MATLAB .mat format (simplified text representation).
/// COBRA Toolbox expects: model.S, model.lb, model.ub, model.c, model.rxns, model.mets
pub fn cobra_write_mat(model : FbaModel) -> String {
  let m = model.metabolites.length()
  let n_r = model.reactions.length()
  let mut sb = ""
  sb = sb + "# COBRA model (MAT format)\n"
  sb = sb + "# Generated by BioSeqs cobra_mat_io\n\n"
  // Metabolites
  sb = sb + "mets = ["
  for i = 0; i < m; i = i + 1 {
    if i > 0 {
      sb = sb + "; "
    }
    sb = sb + "'" + model.metabolites[i] + "'"
  }
  sb = sb + "];\n\n"
  // Reactions
  sb = sb + "rxns = ["
  for j = 0; j < n_r; j = j + 1 {
    if j > 0 {
      sb = sb + "; "
    }
    sb = sb + "'" + model.reactions[j].id + "'"
  }
  sb = sb + "];\n\n"
  // Stoichiometry matrix
  sb = sb + "S = [\n"
  for i = 0; i < m; i = i + 1 {
    for j = 0; j < n_r; j = j + 1 {
      sb = sb + model.stoichiometry[i][j].to_string()
      if j < n_r - 1 {
        sb = sb + " "
      }
    }
    sb = sb + "\n"
  }
  sb = sb + "];\n\n"
  // Lower bounds
  sb = sb + "lb = ["
  for j = 0; j < n_r; j = j + 1 {
    if j > 0 {
      sb = sb + " "
    }
    sb = sb + model.reactions[j].lower_bound.to_string()
  }
  sb = sb + "];\n\n"
  // Upper bounds
  sb = sb + "ub = ["
  for j = 0; j < n_r; j = j + 1 {
    if j > 0 {
      sb = sb + " "
    }
    sb = sb + model.reactions[j].upper_bound.to_string()
  }
  sb = sb + "];\n\n"
  // Objective coefficients
  sb = sb + "c = ["
  for j = 0; j < n_r; j = j + 1 {
    if j > 0 {
      sb = sb + " "
    }
    sb = sb + model.reactions[j].objective.to_string()
  }
  sb = sb + "];\n\n"
  // Reaction names
  sb = sb + "rxnNames = ["
  for j = 0; j < n_r; j = j + 1 {
    if j > 0 {
      sb = sb + "; "
    }
    sb = sb + "'" + model.reactions[j].name + "'"
  }
  sb = sb + "];\n"
  sb
}

///|
/// Parse MATLAB .mat text format to FBA model.
pub fn cobra_read_mat(text : String) -> FbaModel? {
  // Parse metabolites
  let metabolites : Array[String] = Array(capacity=0)
  let mets_section = cobra_mat_extract_array(text, "mets")
  for s in mets_section {
    metabolites.push(s)
  }
  // Parse reactions
  let reaction_ids : Array[String] = Array(capacity=0)
  let rxns_section = cobra_mat_extract_array(text, "rxns")
  for s in rxns_section {
    reaction_ids.push(s)
  }
  // Parse reaction names
  let rxn_names = cobra_mat_extract_array(text, "rxnNames")
  // Parse bounds
  let lb = cobra_mat_extract_numbers(text, "lb")
  let ub = cobra_mat_extract_numbers(text, "ub")
  let c = cobra_mat_extract_numbers(text, "c")
  // Parse stoichiometry
  let stoich : Array[Array[Double]] = Array(capacity=0)
  let s_section = cobra_mat_extract_matrix(text, "S")
  for row in s_section {
    stoich.push(row)
  }
  // Build reactions
  let reactions : Array[FbaReaction] = Array(capacity=0)
  for j = 0; j < reaction_ids.length(); j = j + 1 {
    let name = if j < rxn_names.length() {
      rxn_names[j]
    } else {
      reaction_ids[j]
    }
    let lower = if j < lb.length() { lb[j] } else { 0.0 }
    let upper = if j < ub.length() { ub[j] } else { 1000.0 }
    let obj = if j < c.length() { c[j] } else { 0.0 }
    reactions.push({
      id: reaction_ids[j],
      name,
      lower_bound: lower,
      upper_bound: upper,
      objective: obj,
      genes: [],
    })
  }
  if metabolites.length() == 0 && reactions.length() == 0 {
    return None
  }
  Some({ metabolites, reactions, stoichiometry: stoich, })
}

///|
/// Extract string array from MAT text: name = ['a'; 'b'; ...];
fn cobra_mat_extract_array(text : String, name : String) -> Array[String] {
  let result : Array[String] = Array(capacity=0)
  let pattern = name + " = ["
  let idx = text.find(pattern)
  match idx {
    None => return result
    Some(i) => {
      let start = i + pattern.length()
      let end = text[start:].find("];")
      let section = match end {
        None => text[start:].to_owned()
        Some(e) => text[start:start + e].to_owned()
      }
      // Parse quoted strings
      let mut pos = 0
      while pos < section.length() {
        let q1 = section[pos:].find("'")
        match q1 {
          None => break
          Some(qs) => {
            let search_from = pos + qs + 1
            let q2 = section[search_from:].find("'")
            match q2 {
              None => break
              Some(qe) => {
                result.push(section[search_from:search_from + qe].to_owned())
                pos = search_from + qe + 1
              }
            }
          }
        }
      }
    }
  }
  result
}

///|
/// Extract numeric array from MAT text: name = [1 2 3];
fn cobra_mat_extract_numbers(text : String, name : String) -> Array[Double] {
  let result : Array[Double] = Array(capacity=0)
  let pattern = name + " = ["
  let idx = text.find(pattern)
  match idx {
    None => return result
    Some(i) => {
      let start = i + pattern.length()
      let end = text[start:].find("];")
      let section = match end {
        None => text[start:].to_owned()
        Some(e) => text[start:start + e].to_owned()
      }
      let parts = section.split(" ")
      for p in parts {
        let trimmed = p.trim().to_owned()
        if trimmed.length() > 0 {
          match parse_double(trimmed) {
            Some(d) => result.push(d)
            None => ()
          }
        }
      }
    }
  }
  result
}

///|
/// Extract matrix from MAT text: name = [1 2; 3 4];
fn cobra_mat_extract_matrix(
  text : String,
  name : String,
) -> Array[Array[Double]] {
  let result : Array[Array[Double]] = Array(capacity=0)
  let pattern = name + " = [\n"
  let idx = text.find(pattern)
  match idx {
    None => return result
    Some(i) => {
      let start = i + pattern.length()
      let end = text[start:].find("];")
      let section = match end {
        None => text[start:].to_owned()
        Some(e) => text[start:start + e].to_owned()
      }
      let lines = section.split("\n")
      for line in lines {
        let trimmed = line.trim().to_owned()
        if trimmed.length() == 0 {
          continue
        }
        let row : Array[Double] = Array(capacity=0)
        let parts = trimmed.split(" ")
        for p in parts {
          let t = p.trim().to_owned()
          if t.length() > 0 {
            match parse_double(t) {
              Some(d) => row.push(d)
              None => ()
            }
          }
        }
        if row.length() > 0 {
          result.push(row)
        }
      }
    }
  }
  result
}
